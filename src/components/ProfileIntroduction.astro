---
import { profile } from '../data/profile';
import SocialLinks from './SocialLinks.astro';

interface Props {
	headingId?: string;
}

const { headingId = 'introduction-title' } = Astro.props;
---

<section class="introduction" aria-labelledby={headingId}>
	<div class="introduction__content">
		<h1 id={headingId} class="introduction__name">
			<span>{profile.handle}</span>
			<span class="introduction__separator" aria-hidden="true">/</span>
			<span lang="ja">{profile.penName}</span>
		</h1>
		<p class="introduction__affiliation">
			<span>{profile.affiliation.university}</span>
			<span>{profile.affiliation.faculty}</span>
		</p>
		<SocialLinks />
	</div>

	<div class="introduction__visual">
		<img
			class="introduction__icon"
			src={profile.icon.src}
			alt={`${profile.handle} / ${profile.penName} のアイコン`}
			width={profile.icon.width}
			height={profile.icon.height}
			decoding="async"
		/>
	</div>
</section>

<style>
	.introduction {
		--introduction-icon-max-size: 16rem;
		--introduction-icon-track-ratio: 36%;
		--introduction-safe-inline-padding: clamp(var(--space-2), 3vw, var(--space-4));

		position: relative;
		display: grid;
		grid-template-columns:
			minmax(0, 1fr)
			minmax(
				0,
				min(var(--introduction-icon-max-size), var(--introduction-icon-track-ratio))
			);
		gap: clamp(var(--space-2), 4%, var(--space-5));
		align-content: center;
		align-items: center;
		overflow: hidden;
		box-sizing: border-box;
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
		min-block-size: min(28rem, 58svh);
		padding: clamp(var(--space-3), 6vw, var(--space-5))
			var(--introduction-safe-inline-padding);
		border-block: 1px solid var(--color-border);
		background: transparent;
	}

	.introduction__content {
		position: relative;
		z-index: 1;
		min-inline-size: 0;
	}

	.introduction__visual {
		display: grid;
		place-items: center;
		justify-self: end;
		overflow: clip;
		box-sizing: border-box;
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: min(100%, var(--introduction-icon-max-size));
		aspect-ratio: 1;
	}

	.introduction__icon {
		display: block;
		box-sizing: border-box;
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
		block-size: auto;
		max-block-size: 100%;
		aspect-ratio: 1;
		object-fit: contain;
	}

	.introduction::before {
		position: absolute;
		inset-block-start: 0;
		inset-inline: 0;
		block-size: 0.125rem;
		background: linear-gradient(90deg, var(--color-accent), var(--color-accent-alt));
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		animation: accent-line-enter 600ms 180ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	.introduction::after {
		position: absolute;
		inset-block-end: clamp(var(--space-2), 3vw, var(--space-4));
		inset-inline-end: clamp(var(--space-2), 3vw, var(--space-4));
		inline-size: clamp(2rem, 6vw, 4rem);
		aspect-ratio: 1;
		border-inline-end: 1px dashed var(--color-accent);
		border-block-end: 1px dashed var(--color-accent);
		content: '';
		opacity: 0.65;
	}

	.introduction__name {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 clamp(var(--space-1), 2vw, var(--space-3));
		inline-size: auto;
		max-inline-size: 100%;
		white-space: normal;
		word-break: normal;
		font-family: var(--font-mono);
		animation: content-enter 420ms 100ms ease-out both;
	}

	.introduction__separator {
		color: var(--color-accent-strong);
		font-weight: 300;
		transform: translateY(-0.06em);
	}

	.introduction__affiliation {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin-block-start: var(--space-3);
		padding-inline-start: var(--space-2);
		border-inline-start: 0.2rem solid var(--color-accent);
		font-weight: 600;
		animation: content-enter 420ms 180ms ease-out both;
	}

	@keyframes accent-line-enter {
		to {
			transform: scaleX(1);
		}
	}

	@keyframes content-enter {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.introduction::before,
		.introduction__name,
		.introduction__affiliation {
			animation: none;
		}

		.introduction::before {
			transform: scaleX(1);
		}
	}

	@media (max-width: 30rem) {
		.introduction {
			min-block-size: 24rem;
		}

		.introduction__name {
			font-size: clamp(1.4rem, 7vw, 1.8rem);
		}
	}
</style>
