---
import type { ProjectDefinition } from '../content/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
	projects: readonly Readonly<ProjectDefinition>[];
	cardHeadingLevel?: 'h2' | 'h3';
	emptyMessage?: string;
}

const {
	projects,
	cardHeadingLevel = 'h2',
	emptyMessage = '表示できるプロジェクトはありません。',
} = Astro.props;
---

{
	projects.length > 0 ? (
		<ul class="project-grid" role="list">
			{projects.map((project) => (
				<li>
					<ProjectCard project={project} headingLevel={cardHeadingLevel} />
				</li>
			))}
		</ul>
	) : (
		<p class="project-grid__empty">{emptyMessage}</p>
	)
}

<style>
	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-grid > li {
		min-inline-size: 0;
	}

	.project-grid__empty {
		margin: 0;
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-align: center;
	}
</style>
