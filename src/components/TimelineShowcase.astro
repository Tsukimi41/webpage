---
import type { ProjectDefinition } from '../content/projects';
import type { TimelineEntryDefinition } from '../content/timeline';
import ContentStateNotice from './ContentStateNotice.astro';
import TimelineList from './TimelineList.astro';

interface Props {
	entries: readonly Readonly<TimelineEntryDefinition>[];
	projects: readonly Readonly<ProjectDefinition>[];
}

const { entries, projects } = Astro.props;
const includesMockData = entries.some((entry) => entry.state === 'mock');
---

<section class="timeline-showcase" aria-labelledby="timeline-showcase-title">
	<header class="timeline-showcase__header">
		<div>
			<p class="timeline-showcase__eyebrow" aria-hidden="true">TIMELINE</p>
			<h2 id="timeline-showcase-title">活動履歴</h2>
		</div>
		<ContentStateNotice hasMockData={includesMockData} />
	</header>

	<TimelineList entries={entries} projects={projects} />

	<a class="timeline-showcase__all" href="/timeline/">すべての活動履歴を見る</a>
</section>

<style>
	.timeline-showcase {
		padding-block: clamp(var(--space-5), 10vw, 7rem);
	}

	.timeline-showcase__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-3);
		margin-block-end: var(--space-4);
		padding-block-end: var(--space-3);
		border-block-end: 1px solid var(--color-border);
	}

	.timeline-showcase__eyebrow {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.timeline-showcase h2 {
		margin-block-start: var(--space-1);
	}

	.timeline-showcase__all {
		display: inline-flex;
		min-block-size: 2.75rem;
		align-items: center;
		margin-block-start: var(--space-4);
		color: var(--color-text);
		font-weight: 700;
		text-underline-offset: 0.25em;
	}

	.timeline-showcase__all:is(:hover, :focus-visible) {
		color: var(--color-accent-strong);
	}

	.timeline-showcase__all:focus-visible {
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	@media (max-width: 30rem) {
		.timeline-showcase__header {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
