---
import { createSitePath } from '../config/site';
import type { ArticleFeedItem } from '../content/articles';
import ArticleFeedCard from './ArticleFeedCard.astro';
import ContentStateNotice from './ContentStateNotice.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	items: readonly ArticleFeedItem[];
}

const { items } = Astro.props;
const includesMockData = items.some((item) => item.state === 'mock');
const articlesHref = createSitePath(import.meta.env.BASE_URL, '/articles/');
---

<section class="article-showcase" data-article-carousel aria-labelledby="article-showcase-title">
	<header class="article-showcase__header">
		<div>
			<SectionHeading id="article-showcase-title" label="記事" />
		</div>
		<div class="article-showcase__actions">
			<ContentStateNotice hasMockData={includesMockData} />
			<a href={articlesHref}>すべての記事を見る</a>
		</div>
	</header>

	{items.length > 0 ? (
		<div class="article-carousel__controls" data-carousel-controls hidden>
			<p class="article-carousel__help" id="article-carousel-help">1件ずつ切り替えて読めます。最後の記事の次は、最初に戻ります。</p>
			<div class="article-carousel__navigation">
				<button type="button" data-carousel-previous aria-controls="article-carousel-slides">前の記事</button>
				<p data-carousel-position role="status" aria-atomic="true">1 / {items.length}件</p>
				<button type="button" data-carousel-next aria-controls="article-carousel-slides">次の記事</button>
			</div>
			<label for="article-carousel-select">記事名から選ぶ</label>
			<select id="article-carousel-select" data-carousel-select aria-controls="article-carousel-slides" aria-describedby="article-carousel-help">
				{items.map((item, index) => <option value={index}>{index + 1}. {item.title}</option>)}
			</select>
		</div>
		<div id="article-carousel-slides" class="article-carousel__slides">
			{items.map((item, index) => (
				<div data-carousel-slide role="group" aria-roledescription="スライド" aria-label={`${index + 1} / ${items.length}件`} hidden={index !== 0}>
					<ArticleFeedCard item={item} />
				</div>
			))}
		</div>
		<noscript><p>先頭の1件を表示しています。「すべての記事を見る」から全記事を読めます。</p></noscript>
	) : (
		<p class="article-showcase__empty">表示できる記事はありません。</p>
	)}
</section>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-article-carousel]')) {
		const slides = [...root.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
		const controls = root.querySelector<HTMLElement>('[data-carousel-controls]');
		const previous = root.querySelector<HTMLButtonElement>('[data-carousel-previous]');
		const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
		const select = root.querySelector<HTMLSelectElement>('[data-carousel-select]');
		const position = root.querySelector<HTMLElement>('[data-carousel-position]');
		if (slides.length < 2 || !controls || !previous || !next || !select || !position) continue;

		let current = 0;
		const show = (index: number): void => {
			current = (index + slides.length) % slides.length;
			// Hidden slides are excluded from layout, keyboard navigation and reading order.
			for (const [i, slide] of slides.entries()) slide.hidden = i !== current;
			select.value = String(current);
			position.textContent = `${current + 1} / ${slides.length}件`;
		};
		previous.addEventListener('click', () => show(current - 1));
		next.addEventListener('click', () => show(current + 1));
		select.addEventListener('change', () => show(Number(select.value)));
		root.setAttribute('aria-roledescription', 'カルーセル');
		controls.hidden = false;
	}
</script>

<style>
	.article-showcase {
		container: article-showcase / inline-size;
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
		padding-block: clamp(var(--space-4), 5vw, var(--space-5));
	}

	.article-showcase__header {
		display: flex;
		min-inline-size: 0;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2);
		margin-block-end: var(--space-3);
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--color-border);
	}

	.article-showcase__lead {
		margin-block-start: var(--space-1);
	}

	.article-showcase__actions {
		display: flex;
		min-inline-size: 0;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-2);
	}

	.article-showcase__actions a {
		display: inline-flex;
		align-items: center;
		min-block-size: 2.75rem;
		padding-inline: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		color: var(--color-text);
		font-weight: 700;
		text-decoration: none;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	.article-showcase__actions a:hover {
		border-color: var(--color-accent);
		background: var(--color-surface-raised);
		color: var(--color-accent);
	}

	.article-showcase__actions a:focus-visible {
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.article-carousel__slides {
		inline-size: 100%;
		max-inline-size: 100%;
		margin-inline: 0;
	}
	.article-carousel__controls {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-1);
		margin-block-end: var(--space-2);
	}
	.article-carousel__help { margin: 0; }
	.article-carousel__navigation {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-1);
	}
	.article-carousel__navigation p {
		grid-column: 1 / -1;
		grid-row: 2;
		margin: 0;
		font-variant-numeric: tabular-nums;
	}
	.article-carousel__controls label { font-weight: 700; }
	.article-carousel__controls button,
	.article-carousel__controls select {
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
		min-block-size: 3rem;
		padding: 0.5rem;
		border: 1px solid var(--color-control-border);
		border-radius: var(--radius-small);
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
	}
	.article-carousel__controls button:hover {
		border-color: var(--color-accent);
		background: var(--color-surface-raised);
	}
	/* WebKit can let the native selected text overflow at large text spacing. */
	.article-carousel__controls select { white-space: normal; }
	@container article-showcase (min-width: 36rem) {
		.article-carousel__navigation { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr); }
		.article-carousel__navigation p { grid-column: 2; grid-row: 1; align-self: center; text-align: center; }
	}

	.article-showcase__empty {
		margin: 0;
		padding: var(--space-4);
		border: 1px dashed var(--color-border);
		color: var(--color-text-muted);
		text-align: center;
	}

</style>
