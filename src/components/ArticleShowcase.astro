---
import { createSitePath } from '../config/site';
import type { ArticleFeedItem } from '../content/articles';
import ArticleFeedCard from './ArticleFeedCard.astro';
import ContentStateNotice from './ContentStateNotice.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	items: readonly ArticleFeedItem[];
}

const { items } = Astro.props;
const includesMockData = items.some((item) => item.state === 'mock');
const articlesHref = createSitePath(import.meta.env.BASE_URL, '/articles/');
---

<section class="article-showcase" aria-labelledby="article-showcase-title">
	<header class="article-showcase__header">
		<div>
			<SectionHeading id="article-showcase-title" label="記事" />
		</div>
		<div class="article-showcase__actions">
			<ContentStateNotice hasMockData={includesMockData} />
			<a href={articlesHref}>すべての記事を見る</a>
		</div>
	</header>

	{items.length > 0 ? (
		<div class="article-marquee" aria-label="プロジェクト詳細と長文記事">
			<div class="article-marquee__track">
				<ul class="article-marquee__group" role="list">
					{items.map((item) => <li><ArticleFeedCard item={item} /></li>)}
				</ul>
			</div>
		</div>
	) : (
		<p class="article-showcase__empty">表示できる記事はありません。</p>
	)}
</section>

<style>
	.article-showcase {
		container: article-showcase / inline-size;
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
		padding-block: clamp(var(--space-5), 10vw, 7rem);
	}

	.article-showcase__header {
		display: flex;
		min-inline-size: 0;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2);
		margin-block-end: var(--space-3);
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--color-border);
	}

	.article-showcase__lead {
		margin-block-start: var(--space-1);
	}

	.article-showcase__actions {
		display: flex;
		min-inline-size: 0;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-2);
	}

	.article-showcase__actions a {
		display: inline-flex;
		align-items: center;
		min-block-size: 2.75rem;
		padding-inline: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		color: var(--color-text);
		font-weight: 700;
		text-decoration: none;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	.article-showcase__actions a:hover {
		border-color: var(--color-accent);
		background: var(--color-surface-raised);
		color: var(--color-accent);
	}

	.article-showcase__actions a:focus-visible {
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.article-marquee {
		inline-size: 100%;
		max-inline-size: 100%;
		margin-inline: 0;
	}
	.article-marquee__group {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.article-marquee__group > li { min-inline-size: 0; }

	.article-showcase__empty {
		margin: 0;
		padding: var(--space-4);
		border: 1px dashed var(--color-border);
		color: var(--color-text-muted);
		text-align: center;
	}

</style>
