---
import type { ArticleFeedItem } from '../content/articles';
import ArticleFeedCard from './ArticleFeedCard.astro';
import ContentStateNotice from './ContentStateNotice.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	items: readonly ArticleFeedItem[];
}

const { items } = Astro.props;
const includesMockData = items.some((item) => item.state === 'mock');
---

<section class="article-showcase" aria-labelledby="article-showcase-title">
	<header class="article-showcase__header">
		<div>
			<SectionHeading id="article-showcase-title" label="ARTICLES" />
		</div>
		<div class="article-showcase__actions">
			<ContentStateNotice hasMockData={includesMockData} />
			<a href="/articles/">すべての記事を見る</a>
		</div>
	</header>

	{items.length > 0 ? (
		<div class="article-marquee" aria-label="プロジェクト詳細と長文記事">
			<div class="article-marquee__track">
				<ul class="article-marquee__group" role="list">
					{items.map((item) => <li><ArticleFeedCard item={item} /></li>)}
				</ul>
				<ul class="article-marquee__group article-marquee__group--duplicate" role="list" aria-hidden="true">
					{items.map((item) => <li><ArticleFeedCard item={item} duplicate /></li>)}
				</ul>
			</div>
		</div>
	) : (
		<p class="article-showcase__empty">表示できる記事はありません。</p>
	)}
</section>

<style>
	.article-showcase {
		container: article-showcase / inline-size;
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
		padding-block: clamp(var(--space-5), 10vw, 7rem);
	}

	.article-showcase__header {
		display: flex;
		min-inline-size: 0;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2);
		margin-block-end: var(--space-3);
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--color-border);
	}

	.article-showcase__lead {
		margin-block-start: var(--space-1);
	}

	.article-showcase__actions {
		display: flex;
		min-inline-size: 0;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-2);
	}

	.article-showcase__actions a {
		display: inline-flex;
		align-items: center;
		min-block-size: 2.75rem;
		padding-inline: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		color: var(--color-text);
		font-weight: 700;
		text-decoration: none;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	.article-showcase__actions a:hover {
		border-color: var(--color-accent);
		background: var(--color-surface-raised);
		color: var(--color-accent);
	}

	.article-showcase__actions a:focus-visible {
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.article-marquee {
		position: relative;
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
		margin-inline: 0;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, black 7%, black 93%, transparent);
	}

	.article-marquee__track {
		--article-gap: clamp(var(--space-2), 3vw, var(--space-3));
		display: flex;
		inline-size: max-content;
		padding-block: var(--space-2) var(--space-3);
		animation: article-marquee-scroll 52s linear infinite;
		will-change: transform;
	}

	.article-marquee__group {
		display: flex;
		flex: 0 0 auto;
		gap: var(--article-gap);
		margin: 0 var(--article-gap) 0 0;
		padding: 0;
		list-style: none;
	}

	.article-marquee__group > li {
		inline-size: clamp(17rem, 72cqi, 23rem);
		min-inline-size: 0;
	}

	.article-showcase__empty {
		margin: 0;
		padding: var(--space-4);
		border: 1px dashed var(--color-border);
		color: var(--color-text-muted);
		text-align: center;
	}

	@keyframes article-marquee-scroll {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	@container article-showcase (max-width: 30rem) {
		.article-showcase__header {
			align-items: flex-start;
			flex-direction: column;
		}

		.article-showcase__actions {
			inline-size: 100%;
			justify-content: space-between;
		}

		.article-marquee__group > li {
			inline-size: min(78cqi, 21rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.article-showcase__actions a {
			transition: none;
		}

		.article-marquee {
			mask-image: none;
			overflow-x: auto;
			overflow-y: hidden;
		}

		.article-marquee__track {
			animation: none;
			will-change: auto;
		}

		.article-marquee__group--duplicate {
			display: none;
		}
	}
</style>
