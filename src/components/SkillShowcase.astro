---
import type { ProjectDefinition } from '../content/projects';
import {
	selectProjectsForSkill,
	type SkillCategory,
	type SkillDefinition,
} from '../content/skills';
import ContentStateNotice from './ContentStateNotice.astro';
import SkillVisual from './SkillVisual.astro';

interface Props {
	skills: readonly Readonly<SkillDefinition>[];
	projects: readonly Readonly<ProjectDefinition>[];
}

interface ObjectPlacement {
	readonly x: number;
	readonly y: number;
	readonly size: number;
	readonly delay: number;
}

const { skills, projects } = Astro.props;
const includesMockData = skills.some((skill) => skill.state === 'mock');

const categoryLabels: Readonly<Record<SkillCategory, string>> = {
	language: '言語',
	framework: 'フレームワーク',
	styling: 'スタイリング',
	tool: 'ツール',
};

const bubblePlacements: readonly ObjectPlacement[] = [
	{ x: 18, y: 26, size: 6.75, delay: -1.2 },
	{ x: 49, y: 14, size: 5.75, delay: -3.8 },
	{ x: 77, y: 34, size: 7.25, delay: -2.4 },
	{ x: 35, y: 48, size: 5.25, delay: -4.7 },
	{ x: 66, y: 54, size: 6.25, delay: -0.6 },
] as const;

const marblePlacements: readonly ObjectPlacement[] = [
	{ x: 42, y: 7, size: 7.5, delay: -0.4 },
	{ x: 58, y: 6, size: 6.75, delay: -1.1 },
	{ x: 30, y: 5, size: 5.75, delay: -1.8 },
	{ x: 70, y: 5, size: 5.25, delay: -2.5 },
] as const;

const decorativeBubbles = Array.from({ length: 11 }, (_, index) => ({
	x: (index * 29 + 9) % 92,
	y: (index * 19 + 8) % 63,
	size: 0.7 + (index % 4) * 0.32,
	delay: -(index % 6) * 0.7,
}));

const decorativeMarbles = Array.from({ length: 15 }, (_, index) => ({
	x: 5 + ((index * 17) % 90),
	size: 0.65 + (index % 5) * 0.24,
	stack: index % 2,
}));

let bubbleIndex = 0;
let marbleIndex = 0;

const skillObjects = skills.map((skill) => {
	const placements = skill.presentation === 'bubble' ? bubblePlacements : marblePlacements;
	const placementIndex = skill.presentation === 'bubble' ? bubbleIndex++ : marbleIndex++;
	const placement = placements[placementIndex % placements.length] ?? placements[0];

	return { skill, placement };
});
---

<section class="skill-showcase" aria-labelledby="skill-showcase-title">
	<header class="skill-showcase__header">
		<div>
			<p class="skill-showcase__eyebrow" aria-hidden="true">FOCUS</p>
			<h2 id="skill-showcase-title">得意・注力領域</h2>
			<p class="skill-showcase__lead">今までに触れたことのある技術です。</p>
		</div>
		<ContentStateNotice hasMockData={includesMockData} />
	</header>

	{skills.length === 0 && <p class="skill-showcase__empty">表示できる技術はありません。</p>}

	<div class:list={['skill-box', { 'skill-box--empty': skills.length === 0 }]}>
		<div class="skill-field" data-skill-field aria-label="技術アイコンのインタラクティブ表示">
			<div class="skill-field__light" aria-hidden="true"></div>

			{decorativeBubbles.map((bubble) => (
				<span
					class="ambient-bubble"
					style={`--ambient-x:${bubble.x}%;--ambient-y:${bubble.y}%;--ambient-size:${bubble.size}rem;--ambient-delay:${bubble.delay}s`}
					aria-hidden="true"
				></span>
			))}

			<div class="marble-bed" aria-hidden="true">
				{decorativeMarbles.map((marble) => (
					<span
						style={`--marble-x:${marble.x}%;--marble-size:${marble.size}rem;--marble-stack:${marble.stack}`}
					></span>
				))}
			</div>

			<ul class="skill-objects" role="list">
				{skillObjects.map(({ skill, placement }) => (
					<li
						class={`skill-object skill-object--${skill.presentation}`}
						data-skill-object
						data-presentation={skill.presentation}
						style={`--object-x:${placement.x}%;--object-y:${placement.y}%;--object-size:${placement.size}rem;--object-delay:${placement.delay}s`}
					>
						<a href={`#skill-note-${skill.id}`} aria-label={`${skill.label}の経験と関連プロジェクトを見る`}>
							<span class="skill-object__surface" aria-hidden="true">
								<span class="skill-object__symbol">
									<SkillVisual visual={skill.visual} />
								</span>
							</span>
							<span class="skill-object__label">{skill.label}</span>
						</a>
					</li>
				))}
			</ul>
		</div>

		<ul class="skill-notes" aria-label="技術経験の詳細" role="list">
			{skills.map((skill) => {
				const relatedProjects = selectProjectsForSkill(projects, skill.id);

				return (
					<li id={`skill-note-${skill.id}`} class="skill-note">
						<article>
							<header>
								<p>{categoryLabels[skill.category]}</p>
								<h3>{skill.label}</h3>
							</header>
							<p class="skill-note__summary">{skill.summary}</p>
							<ul class="skill-note__evidence" aria-label={`${skill.label}を使用したプロジェクト`} role="list">
								{relatedProjects.map((project) => (
									<li><a href={`/projects/${project.slug}/`}>{project.title}</a></li>
								))}
							</ul>
							{skill.visual.kind === 'image' && skill.visual.sourceName && skill.visual.sourceUrl && (
								<p class="skill-note__credit">
									素材: <a href={skill.visual.sourceUrl} target="_blank" rel="noopener noreferrer">{skill.visual.sourceName}</a>
									{skill.visual.license && ` / ${skill.visual.license}`}
								</p>
							)}
						</article>
					</li>
				);
			})}
		</ul>
	</div>
</section>

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const fields = document.querySelectorAll<HTMLElement>('[data-skill-field]');

	fields.forEach((field) => {
		if (field.dataset.pointerReady === 'true' || reducedMotion.matches) {
			return;
		}

		field.dataset.pointerReady = 'true';
		const objects = Array.from(field.querySelectorAll<HTMLElement>('[data-skill-object]'));
		let animationFrame: number | undefined;
		let pointerX = 0;
		let pointerY = 0;

		const updateObjects = (): void => {
			animationFrame = undefined;

			for (const object of objects) {
				const bounds = object.getBoundingClientRect();
				const deltaX = pointerX - (bounds.left + bounds.width / 2);
				const deltaY = pointerY - (bounds.top + bounds.height / 2);
				const distance = Math.max(Math.hypot(deltaX, deltaY), 1);
				const influence = Math.max(0, 1 - distance / 190);
				const direction = object.dataset.presentation === 'marble' ? -1 : 1;
				const strength = object.dataset.presentation === 'marble' ? 16 : 9;

				object.style.setProperty('--pointer-x', `${(deltaX / distance) * influence * strength * direction}px`);
				object.style.setProperty('--pointer-y', `${(deltaY / distance) * influence * strength * direction}px`);
			}
		};

		field.addEventListener('pointermove', (event) => {
			pointerX = event.clientX;
			pointerY = event.clientY;

			if (animationFrame === undefined) {
				animationFrame = window.requestAnimationFrame(updateObjects);
			}
		});

		field.addEventListener('pointerleave', () => {
			if (animationFrame !== undefined) {
				window.cancelAnimationFrame(animationFrame);
				animationFrame = undefined;
			}

			for (const object of objects) {
				object.style.removeProperty('--pointer-x');
				object.style.removeProperty('--pointer-y');
			}
		});
	});
</script>

<style>
	.skill-showcase {
		padding-block: clamp(var(--space-5), 10vw, 7rem);
	}

	.skill-showcase__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-3);
		margin-block-end: var(--space-4);
		padding-block-end: var(--space-3);
		border-block-end: 1px solid var(--color-border);
	}

	.skill-showcase__eyebrow,
	.skill-note header p {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.skill-showcase h2,
	.skill-note h3 {
		margin-block-start: var(--space-1);
	}

	.skill-showcase__lead {
		margin-block-start: var(--space-1);
	}

	.skill-box {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		background: color-mix(in srgb, var(--color-surface) 94%, transparent);
		box-shadow: 0 1.5rem 4rem var(--color-shadow);
	}

	.skill-box--empty {
		display: none;
	}

	.skill-showcase__empty {
		padding: var(--space-3);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.skill-field {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-block-size: clamp(25rem, 58vw, 35rem);
		border-block-end: 1px solid var(--color-border);
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 7%, transparent), transparent 55%),
			radial-gradient(circle at 50% 115%, var(--color-backdrop-glow), transparent 55%),
			var(--color-canvas);
		contain: layout paint;
	}

	.skill-field__light {
		position: absolute;
		z-index: -1;
		inset: 0;
		background:
			radial-gradient(circle at 22% 15%, rgb(255 255 255 / 13%), transparent 17rem),
			linear-gradient(115deg, transparent 42%, rgb(255 255 255 / 4%) 48%, transparent 54%);
		pointer-events: none;
	}

	.skill-objects {
		position: absolute;
		inset: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.skill-object {
		--pointer-x: 0px;
		--pointer-y: 0px;
		position: absolute;
		z-index: 3;
		inset-block-start: var(--object-y);
		inset-inline-start: var(--object-x);
		inline-size: var(--object-size);
		transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
		transform: translate(-50%, -50%) translate(var(--pointer-x), var(--pointer-y));
		will-change: transform;
	}

	.skill-object--marble {
		inset-block: auto var(--object-y);
		transform: translateX(-50%) translate(var(--pointer-x), var(--pointer-y));
	}

	.skill-object a {
		display: grid;
		justify-items: center;
		gap: 0.35rem;
		color: var(--color-text);
		text-align: center;
		text-decoration: none;
	}

	.skill-object__surface {
		position: relative;
		display: grid;
		place-items: center;
		inline-size: 100%;
		aspect-ratio: 1;
		border-radius: 50%;
	}

	.skill-object--bubble .skill-object__surface {
		border: 1px solid rgb(255 255 255 / 54%);
		background:
			radial-gradient(circle at 31% 24%, rgb(255 255 255 / 88%) 0 4%, transparent 10%),
			radial-gradient(circle at 66% 72%, rgb(105 231 255 / 22%), transparent 34%),
			conic-gradient(from 205deg, rgb(255 106 193 / 22%), rgb(116 229 255 / 24%), rgb(255 244 132 / 20%), rgb(188 129 255 / 24%), rgb(255 106 193 / 22%));
		box-shadow:
			inset 0.45rem 0.55rem 1.2rem rgb(255 255 255 / 19%),
			inset -0.65rem -0.8rem 1.4rem rgb(77 190 255 / 13%),
			0 0.5rem 1.6rem rgb(0 0 0 / 18%),
			0 0 1.4rem rgb(161 225 255 / 16%);
		backdrop-filter: blur(0.18rem);
		animation: bubble-float 5.6s var(--object-delay) ease-in-out infinite;
	}

	.skill-object--bubble .skill-object__surface::before {
		position: absolute;
		inset-block-start: 13%;
		inset-inline-start: 18%;
		inline-size: 40%;
		block-size: 21%;
		border-radius: 50%;
		background: linear-gradient(145deg, rgb(255 255 255 / 78%), rgb(255 255 255 / 4%));
		content: '';
		filter: blur(0.08rem);
		transform: rotate(-24deg);
	}

	.skill-object--bubble .skill-object__surface::after {
		position: absolute;
		inset: 4%;
		border: 1px solid rgb(255 255 255 / 24%);
		border-radius: 50%;
		content: '';
		box-shadow:
			inset 0.18rem 0.05rem 0.35rem rgb(255 118 200 / 25%),
			inset -0.18rem -0.08rem 0.4rem rgb(88 231 255 / 25%);
	}

	.skill-object--marble .skill-object__surface {
		border: 0.125rem solid color-mix(in srgb, var(--color-border) 75%, white);
		background:
			radial-gradient(circle at 32% 25%, rgb(255 255 255 / 72%) 0 5%, transparent 14%),
			radial-gradient(circle at 43% 38%, var(--color-accent-strong), var(--color-accent) 31%, var(--color-surface-raised) 72%);
		box-shadow:
			inset -0.8rem -1rem 1.4rem rgb(0 0 0 / 30%),
			inset 0.3rem 0.35rem 0.7rem rgb(255 255 255 / 20%),
			0 0.75rem 0.35rem -0.35rem rgb(0 0 0 / 42%),
			0 0 1.2rem var(--color-backdrop-glow);
		animation: marble-drop 820ms var(--object-delay) cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.skill-object__symbol {
		position: relative;
		z-index: 2;
		display: grid;
		place-items: center;
		inline-size: 42%;
		aspect-ratio: 1;
		filter: drop-shadow(0 0.12rem 0.2rem rgb(0 0 0 / 28%));
		transition: transform 180ms ease;
	}

	.skill-object__label {
		max-inline-size: 8rem;
		padding: 0.12rem 0.38rem;
		border: 1px solid color-mix(in srgb, var(--color-border) 75%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-canvas) 82%, transparent);
		font-size: 0.7rem;
		font-weight: 800;
		line-height: 1.25;
		box-shadow: 0 0.25rem 0.7rem var(--color-shadow);
		overflow-wrap: anywhere;
	}

	.skill-object a:is(:hover, :focus-visible) .skill-object__symbol {
		transform: scale(1.16) rotate(-7deg);
	}

	.skill-object a:focus-visible {
		border-radius: 50%;
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.3rem;
	}

	.ambient-bubble {
		position: absolute;
		z-index: 1;
		inset-block-start: var(--ambient-y);
		inset-inline-start: var(--ambient-x);
		inline-size: var(--ambient-size);
		aspect-ratio: 1;
		border: 1px solid rgb(255 255 255 / 28%);
		border-radius: 50%;
		background: radial-gradient(circle at 30% 24%, rgb(255 255 255 / 60%), transparent 25%);
		box-shadow: inset -0.2rem -0.2rem 0.45rem rgb(137 102 255 / 15%);
		opacity: 0.72;
		animation: ambient-float 4.8s var(--ambient-delay) ease-in-out infinite;
		pointer-events: none;
	}

	.marble-bed {
		position: absolute;
		z-index: 0;
		inset: auto 0 0;
		block-size: 4.5rem;
		pointer-events: none;
	}

	.marble-bed span {
		position: absolute;
		inset-block-end: calc(var(--marble-stack) * 0.45rem);
		inset-inline-start: var(--marble-x);
		inline-size: var(--marble-size);
		aspect-ratio: 1;
		border: 1px solid rgb(255 255 255 / 22%);
		border-radius: 50%;
		background: radial-gradient(circle at 32% 27%, rgb(255 255 255 / 55%) 0 7%, var(--color-accent) 25%, var(--color-surface-raised) 73%);
		box-shadow: 0 0.35rem 0.3rem -0.2rem rgb(0 0 0 / 45%);
		transform: translateX(-50%);
	}

	.skill-notes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: 1px;
		margin: 0;
		padding: 1px;
		background: var(--color-border);
		list-style: none;
	}

	.skill-note {
		min-inline-size: 0;
		background: var(--color-surface);
		scroll-margin-block-start: var(--space-3);
	}

	.skill-note:target {
		background: color-mix(in srgb, var(--color-accent) 9%, var(--color-surface));
		box-shadow: inset 0 0 0 0.125rem var(--color-accent);
	}

	.skill-note article {
		display: flex;
		min-block-size: 100%;
		flex-direction: column;
		padding: var(--space-3);
	}

	.skill-note h3 {
		font-size: 1.15rem;
	}

	.skill-note__summary {
		margin-block-start: var(--space-2);
		overflow-wrap: anywhere;
	}

	.skill-note__evidence {
		display: grid;
		gap: var(--space-1);
		margin: auto 0 0;
		padding: var(--space-3) 0 0;
		list-style: none;
	}

	.skill-note__evidence a,
	.skill-note__credit a {
		color: var(--color-text);
		font-weight: 700;
		text-underline-offset: 0.25em;
	}

	.skill-note__evidence a {
		display: inline-flex;
		min-block-size: 2.75rem;
		align-items: center;
		overflow-wrap: anywhere;
	}

	.skill-note__evidence a:is(:hover, :focus-visible),
	.skill-note__credit a:is(:hover, :focus-visible) {
		color: var(--color-accent-strong);
	}

	.skill-note__evidence a:focus-visible,
	.skill-note__credit a:focus-visible {
		border-radius: var(--radius-small);
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.skill-note__credit {
		font-size: 0.75rem;
	}

	@keyframes bubble-float {
		0%, 100% { transform: translate3d(0, 0.35rem, 0) rotate(-1deg); }
		45% { transform: translate3d(0.35rem, -0.65rem, 0) rotate(2deg); }
		72% { transform: translate3d(-0.25rem, -0.2rem, 0) rotate(0deg); }
	}

	@keyframes ambient-float {
		50% { transform: translate3d(0.2rem, -0.55rem, 0) scale(1.06); }
	}

	@keyframes marble-drop {
		from { opacity: 0; transform: translateY(-10rem) rotate(-90deg); }
		70% { opacity: 1; transform: translateY(0.4rem) rotate(8deg); }
		to { opacity: 1; transform: translateY(0) rotate(0); }
	}

	@supports not (background: color-mix(in srgb, black, white)) {
		.skill-box,
		.skill-note { background: var(--color-surface); }
		.skill-object__label { background: var(--color-canvas); }
	}

	@media (max-width: 30rem) {
		.skill-showcase__header { align-items: flex-start; flex-direction: column; }
		.skill-field { min-block-size: 28rem; }
		.skill-object { --object-size: min(var(--object-size), 6rem); }
	}

	@media (prefers-reduced-motion: reduce) {
		.skill-object,
		.skill-object__surface,
		.skill-object__symbol,
		.ambient-bubble { animation: none; transition: none; }
		.skill-object a:is(:hover, :focus-visible) .skill-object__symbol { transform: none; }
	}
</style>
