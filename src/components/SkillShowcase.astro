---
import type { SkillDefinition } from '../content/skills';
import ContentStateNotice from './ContentStateNotice.astro';
import SkillVisual from './SkillVisual.astro';

interface Props {
	skills: readonly Readonly<SkillDefinition>[];
}

interface ObjectPlacement {
	readonly x: number;
	readonly y: number;
	readonly size: number;
	readonly delay: number;
}

const { skills } = Astro.props;
const includesMockData = skills.some((skill) => skill.state === 'mock');

const bubblePlacements: readonly ObjectPlacement[] = [
	{ x: 18, y: 26, size: 6.75, delay: -1.2 },
	{ x: 49, y: 14, size: 5.75, delay: -3.8 },
	{ x: 77, y: 34, size: 7.25, delay: -2.4 },
	{ x: 35, y: 48, size: 5.25, delay: -4.7 },
	{ x: 66, y: 54, size: 6.25, delay: -0.6 },
] as const;

const marblePlacements: readonly ObjectPlacement[] = [
	{ x: 42, y: 7, size: 7.5, delay: -0.4 },
	{ x: 58, y: 6, size: 6.75, delay: -1.1 },
	{ x: 30, y: 5, size: 5.75, delay: -1.8 },
	{ x: 70, y: 5, size: 5.25, delay: -2.5 },
] as const;

const decorativeBubbles = Array.from({ length: 6 }, (_, index) => ({
	x: (index * 29 + 9) % 92,
	y: (index * 19 + 8) % 63,
	size: 0.7 + (index % 4) * 0.32,
	delay: -(index % 6) * 0.7,
}));

let bubbleIndex = 0;
let marbleIndex = 0;

const skillObjects = skills.map((skill) => {
	const placements = skill.presentation === 'bubble' ? bubblePlacements : marblePlacements;
	const placementIndex = skill.presentation === 'bubble' ? bubbleIndex++ : marbleIndex++;
	const placement = placements[placementIndex % placements.length] ?? placements[0];

	return { skill, placement };
});
---

<section class="skill-showcase" aria-labelledby="skill-showcase-title">
	<header class="skill-showcase__header">
		<div>
			<h2 id="skill-showcase-title">SKILLS</h2>
			<p class="skill-showcase__lead">今までに触れたことのある技術です。</p>
		</div>
		<ContentStateNotice hasMockData={includesMockData} />
	</header>

	{skills.length === 0 && <p class="skill-showcase__empty">表示できる技術はありません。</p>}

	<div class:list={['skill-box', { 'skill-box--empty': skills.length === 0 }]}>
		<div class="skill-field" data-skill-field aria-label="技術アイコンのインタラクティブ表示">
			<div class="skill-field__light" aria-hidden="true"></div>

			{decorativeBubbles.map((bubble) => (
				<span
					class="ambient-bubble"
					data-physics-object
					data-physics-material="bubble"
					data-physics-role="ambient"
					data-burst-state="idle"
					data-physics-x={bubble.x}
					data-physics-y={bubble.y}
					style={`--ambient-x:${bubble.x}%;--ambient-y:${bubble.y}%;--ambient-size:${bubble.size}rem;--ambient-delay:${bubble.delay}s`}
					aria-hidden="true"
				></span>
			))}

			<ul class="skill-objects" role="list">
				{skillObjects.map(({ skill, placement }) => (
					<li
						class={`skill-object skill-object--${skill.presentation}`}
						data-content-state={skill.state}
						data-physics-object
						data-physics-material={skill.presentation}
						data-physics-role="skill"
						data-physics-x={placement.x}
						data-physics-y={placement.y}
						style={`--object-x:${placement.x}%;--object-y:${placement.y}%;--object-size:${placement.size}rem;--object-delay:${placement.delay}s`}
					>
						<button
							type="button"
							data-physics-control
							aria-label={skill.presentation === 'marble'
								? `${skill.label}のマーブル。ドラッグして投げるか、矢印キーで動かせます`
								: `${skill.label}のシャボン玉。ポインターで触れるか、矢印キーで動かせます`}
						>
							<span class="skill-object__surface" aria-hidden="true">
								<span class="skill-object__symbol">
									<SkillVisual visual={skill.visual} />
								</span>
							</span>
							<span class="skill-object__label">{skill.label}</span>
						</button>
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<script>
	import { startSkillPhysics } from '../scripts/skill-physics';

	const fields = document.querySelectorAll<HTMLElement>('[data-skill-field]');
	const disposePhysics = Array.from(fields, startSkillPhysics);
	const cleanupPhysics = (): void => {
		disposePhysics.forEach((dispose) => dispose());
	};

	document.addEventListener('astro:before-swap', cleanupPhysics, { once: true });
</script>

<style>
	.skill-showcase {
		padding-block: clamp(var(--space-5), 10vw, 7rem);
	}

	.skill-showcase__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-3);
		margin-block-end: var(--space-4);
		padding-block-end: var(--space-3);
		border-block-end: 1px solid var(--color-border);
	}

	.skill-showcase h2 {
		margin-block-start: var(--space-1);
	}

	.skill-showcase__lead {
		margin-block-start: var(--space-1);
	}

	.skill-box {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 0;
		background: color-mix(in srgb, var(--color-surface) 94%, transparent);
		box-shadow: 0.4rem 0.4rem 0 var(--color-shadow);
	}

	.skill-box--empty {
		display: none;
	}

	.skill-showcase__empty {
		padding: var(--space-3);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.skill-field {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-block-size: clamp(25rem, 58vw, 35rem);
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 7%, transparent), transparent 55%),
			radial-gradient(circle at 50% 115%, var(--color-backdrop-glow), transparent 55%),
			var(--color-canvas);
		contain: layout paint;
		touch-action: pan-y pinch-zoom;
		user-select: none;
	}

	.skill-field__light {
		position: absolute;
		z-index: -1;
		inset: 0;
		background:
			radial-gradient(circle at 22% 15%, rgb(255 255 255 / 13%), transparent 17rem),
			linear-gradient(115deg, transparent 42%, rgb(255 255 255 / 4%) 48%, transparent 54%);
		pointer-events: none;
	}

	.skill-objects {
		position: absolute;
		inset: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.skill-object {
		--rotation: 0rad;
		--shadow-blur: 0.28rem;
		--shadow-offset-y: 0px;
		--shadow-opacity: 0.52;
		--shadow-scale: 0.92;

		position: absolute;
		z-index: 3;
		inset-block-start: var(--object-y);
		inset-inline-start: var(--object-x);
		inline-size: var(--object-size);
		block-size: var(--object-size);
		border-radius: 50%;
		transform: translate(-50%, -50%);
		will-change: transform;
	}

	.skill-object--marble {
		inset-block: auto var(--object-y);
		transform: translateX(-50%);
	}

	.skill-object--bubble {
		--deform-x: 1;
		--deform-y: 1;
		--deform-angle: 0rad;
		--deform-radius: 50%;
	}

	.skill-object button {
		position: relative;
		display: block;
		inline-size: 100%;
		block-size: 100%;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--color-text);
		font: inherit;
		text-align: center;
		cursor: grab;
		touch-action: none;
		-webkit-appearance: none;
		appearance: none;
	}

	.skill-object.is-dragged {
		z-index: 8;
	}

	.skill-object.is-dragged button {
		cursor: grabbing;
	}

	.skill-object--bubble button {
		cursor: pointer;
	}

	.skill-object__surface {
		position: absolute;
		z-index: 1;
		inset: 0;
		display: grid;
		place-items: center;
		inline-size: 100%;
		block-size: 100%;
		box-sizing: border-box;
		border-radius: 50%;
		overflow: hidden;
	}

	.skill-object--bubble .skill-object__surface {
		border: 1px solid rgb(255 255 255 / 54%);
		border-radius: var(--deform-radius);
		background:
			radial-gradient(circle at 31% 24%, rgb(255 255 255 / 88%) 0 4%, transparent 10%),
			radial-gradient(circle at 66% 72%, rgb(105 231 255 / 22%), transparent 34%),
			conic-gradient(from 205deg, rgb(255 106 193 / 22%), rgb(116 229 255 / 24%), rgb(255 244 132 / 20%), rgb(188 129 255 / 24%), rgb(255 106 193 / 22%));
		box-shadow:
			inset 0.45rem 0.55rem 1.2rem rgb(255 255 255 / 19%),
			inset -0.65rem -0.8rem 1.4rem rgb(77 190 255 / 13%),
			0 0.5rem 1.6rem rgb(0 0 0 / 18%),
			0 0 1.4rem rgb(161 225 255 / 16%);
		backdrop-filter: blur(0.18rem);
		transform: rotate(var(--deform-angle)) scale(var(--deform-x), var(--deform-y));
		transition: filter 160ms ease;
	}

	.skill-object--bubble .skill-object__surface::before {
		position: absolute;
		inset-block-start: 13%;
		inset-inline-start: 18%;
		inline-size: 40%;
		block-size: 21%;
		border-radius: 50%;
		background: linear-gradient(145deg, rgb(255 255 255 / 78%), rgb(255 255 255 / 4%));
		content: '';
		filter: blur(0.08rem);
		transform: rotate(-24deg);
	}

	.skill-object--bubble .skill-object__surface::after {
		position: absolute;
		inset: 4%;
		border: 1px solid rgb(255 255 255 / 24%);
		border-radius: inherit;
		content: '';
		box-shadow:
			inset 0.18rem 0.05rem 0.35rem rgb(255 118 200 / 25%),
			inset -0.18rem -0.08rem 0.4rem rgb(88 231 255 / 25%);
	}

	.skill-object--marble .skill-object__surface {
		border: 0.0625rem solid color-mix(in srgb, var(--color-marble-rim) 78%, var(--color-border));
		background:
			radial-gradient(
				circle at 29% 22%,
				var(--color-marble-highlight) 0 3%,
				color-mix(in srgb, var(--color-marble-highlight) 34%, transparent) 4% 7%,
				transparent 13%
			),
			radial-gradient(
				ellipse at 70% 76%,
				color-mix(in srgb, var(--color-marble-rim) 26%, transparent) 0 14%,
				transparent 46%
			),
			conic-gradient(
				from 214deg at 51% 49%,
				transparent 0 13%,
				color-mix(in srgb, var(--color-marble-vein) 74%, transparent) 17% 22%,
				transparent 28% 61%,
				color-mix(in srgb, var(--color-marble-vein) 48%, transparent) 66% 71%,
				transparent 77%
			),
			radial-gradient(
				circle at 40% 34%,
				var(--color-marble-core) 0 12%,
				var(--color-marble-mid) 48%,
				var(--color-marble-edge) 100%
			);
		box-shadow:
			inset 0.32rem 0.38rem 0.72rem color-mix(in srgb, var(--color-marble-highlight) 22%, transparent),
			inset -0.82rem -0.96rem 1.3rem color-mix(in srgb, var(--color-marble-shadow) 76%, transparent),
			inset 0 0 0 0.0625rem color-mix(in srgb, var(--color-marble-rim) 40%, transparent),
			0 0.38rem 1rem color-mix(in srgb, var(--color-marble-shadow) 42%, transparent),
			0 0 1.1rem var(--color-marble-glow);
		transition: filter 160ms ease;
		transform: rotate(var(--rotation));
	}

	.skill-object--marble button::after {
		position: absolute;
		z-index: 0;
		inset-block-start: calc(100% - 0.35rem);
		inset-inline: 12%;
		block-size: 0.45rem;
		border-radius: 50%;
		background: var(--color-marble-shadow);
		content: '';
		filter: blur(var(--shadow-blur));
		opacity: var(--shadow-opacity);
		pointer-events: none;
		transform: translateY(var(--shadow-offset-y)) scaleX(var(--shadow-scale));
	}

	.skill-object__symbol {
		position: relative;
		z-index: 2;
		display: grid;
		place-items: center;
		inline-size: 42%;
		aspect-ratio: 1;
		filter: drop-shadow(0 0.12rem 0.2rem rgb(0 0 0 / 28%));
		transition: transform 180ms ease;
	}

	.skill-object--marble .skill-object__symbol {
		color: var(--color-marble-symbol);
		filter: drop-shadow(
			0 0.1rem 0.14rem color-mix(in srgb, var(--color-marble-highlight) 38%, transparent)
		);
	}

	.skill-object__label {
		position: absolute;
		z-index: 4;
		inset-block-end: 0.35rem;
		inset-inline-start: 50%;
		max-inline-size: 90%;
		padding: 0.12rem 0.38rem;
		border: 1px solid color-mix(in srgb, var(--color-border) 75%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-canvas) 82%, transparent);
		font-size: 0.7rem;
		font-weight: 800;
		line-height: 1.25;
		box-shadow: 0 0.25rem 0.7rem var(--color-shadow);
		opacity: 0;
		overflow-wrap: anywhere;
		transform: translate(-50%, 0.35rem);
		transition:
			opacity 140ms ease,
			transform 140ms ease,
			visibility 0s linear 140ms;
		visibility: hidden;
	}

	.skill-object button:is(:hover, :focus-visible) .skill-object__label {
		opacity: 1;
		transform: translate(-50%, 0);
		transition-delay: 0s;
		visibility: visible;
	}

	.skill-object button:is(:hover, :focus-visible) .skill-object__symbol {
		transform: scale(1.16) rotate(-7deg);
	}

	.skill-object button:focus-visible {
		border-radius: 50%;
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.3rem;
	}

	.ambient-bubble {
		--deform-x: 1;
		--deform-y: 1;
		--deform-angle: 0rad;
		--burst-angle: 0rad;
		--burst-duration: 360ms;
		--burst-hue: 0deg;
		--burst-rotation: 0deg;
		--burst-scale: 1.8;

		position: absolute;
		z-index: 1;
		inset-block-start: var(--ambient-y);
		inset-inline-start: var(--ambient-x);
		inline-size: var(--ambient-size);
		aspect-ratio: 1;
		border: 1px solid rgb(255 255 255 / 28%);
		border-radius: 50%;
		background: radial-gradient(circle at 30% 24%, rgb(255 255 255 / 60%), transparent 25%);
		box-shadow: inset -0.2rem -0.2rem 0.45rem rgb(137 102 255 / 15%);
		opacity: 0.72;
		pointer-events: none;
		rotate: var(--deform-angle);
		scale: var(--deform-x) var(--deform-y);
	}

	.ambient-bubble[data-burst-state='bursting'] {
		animation: ambient-bubble-burst var(--burst-duration) ease-out both;
	}

	.ambient-bubble[data-burst-state='bursting']::before,
	.ambient-bubble[data-burst-state='bursting']::after {
		position: absolute;
		inset: 50% auto auto 50%;
		content: '';
		pointer-events: none;
	}

	.ambient-bubble[data-burst-state='bursting']::before {
		inline-size: 100%;
		aspect-ratio: 1;
		border: 1px solid rgb(255 255 255 / 72%);
		border-radius: 50%;
		animation: ambient-burst-ring var(--burst-duration) ease-out both;
		filter: hue-rotate(var(--burst-hue));
	}

	.ambient-bubble[data-burst-variant='1']::before {
		border-style: dashed;
	}

	.ambient-bubble[data-burst-variant='2']::before {
		border-width: 0.125rem;
		box-shadow: 0 0 0.45rem rgb(125 224 255 / 48%);
	}

	.ambient-bubble[data-burst-variant='3']::after {
		box-shadow:
			0.9rem 0.12rem rgb(120 224 255 / 76%),
			-0.78rem 0.36rem rgb(255 132 215 / 72%),
			0.28rem -0.92rem rgb(255 247 155 / 74%),
			-0.38rem 0.84rem rgb(181 137 255 / 72%),
			0.65rem -0.58rem rgb(154 255 203 / 70%);
	}

	.ambient-bubble[data-burst-state='bursting']::after {
		inline-size: 0.16rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: rgb(255 255 255 / 82%);
		box-shadow:
			0.72rem 0 rgb(120 224 255 / 76%),
			-0.62rem 0.24rem rgb(255 132 215 / 72%),
			0.18rem -0.74rem rgb(255 247 155 / 74%),
			-0.2rem 0.68rem rgb(181 137 255 / 72%);
		animation: ambient-burst-droplets var(--burst-duration) ease-out both;
		filter: hue-rotate(var(--burst-hue));
	}

	@keyframes ambient-bubble-burst {
		0% { opacity: 0.72; filter: brightness(1); }
		35% { opacity: 0.95; filter: brightness(1.7); }
		100% { opacity: 0; filter: brightness(2); }
	}

	@keyframes ambient-burst-ring {
		from { opacity: 0.85; transform: translate(-50%, -50%) rotate(var(--burst-angle)) scale(0.45); }
		to { opacity: 0; transform: translate(-50%, -50%) rotate(var(--burst-angle)) scale(2.25); }
	}

	@keyframes ambient-burst-droplets {
		from { opacity: 0.95; transform: translate(-50%, -50%) rotate(var(--burst-angle)) scale(0.25); }
		to { opacity: 0; transform: translate(-50%, -50%) rotate(calc(var(--burst-angle) + var(--burst-rotation))) scale(var(--burst-scale)); }
	}

	@supports not (background: color-mix(in srgb, black, white)) {
		.skill-box { background: var(--color-surface); }
		.skill-object__label { background: var(--color-canvas); }
	}

	@media (max-width: 30rem) {
		.skill-showcase__header { align-items: flex-start; flex-direction: column; }
		.skill-field { min-block-size: 28rem; }
		.skill-object { --object-size: min(var(--object-size), 6rem); }
	}

	@media (prefers-reduced-motion: reduce) {
		.skill-object,
		.skill-object__surface,
		.skill-object__symbol { animation: none; transition: none; }
		.skill-object button:is(:hover, :focus-visible) .skill-object__symbol { transform: none; }
		.skill-object__label { transition: none; }
		.ambient-bubble[data-burst-state='bursting'],
		.ambient-bubble[data-burst-state='bursting']::before,
		.ambient-bubble[data-burst-state='bursting']::after { animation: none; }
	}
</style>
