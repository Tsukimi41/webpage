---
import type { BlogPostView } from '../content/blog';
import BlogCard from './BlogCard.astro';

interface Props {
	posts: readonly Readonly<BlogPostView>[];
	emptyMessage?: string;
}

const { posts, emptyMessage = '表示できるブログ記事はありません。' } = Astro.props;
---

{posts.length > 0 ? (
	<ul class="blog-list" role="list">
		{posts.map((view) => (
			<li>
				<BlogCard view={view} />
			</li>
		))}
	</ul>
) : (
	<p class="blog-list__empty">{emptyMessage}</p>
)}

<style>
	.blog-list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.blog-list li {
		min-inline-size: 0;
	}

	.blog-list__empty {
		margin: 0;
		padding: var(--space-4);
		border: 1px dashed var(--color-border);
		color: var(--color-text-muted);
		text-align: center;
	}

</style>
