---
import { profileDisplayName } from '../data/profile';
import SocialLinks from './SocialLinks.astro';
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__main">
			<div class="site-footer__site-nav">
				<SocialLinks accessibleLabel="外部プロフィール" />
				<span class="site-footer__divider" aria-hidden="true"></span>
				<nav class="site-footer__nav" aria-label="フッターメニュー">
					<a href="/">Home</a>
					<a href="/profile/">Profile</a>
					<a href="/blog/">Blog</a>
				</nav>
			</div>
			<a class="site-footer__top" href="#site-top">
				<svg
					class="site-footer__top-icon"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					focusable="false"
				>
					<path d="m5 15 7-7 7 7"></path>
				</svg>
				<span>一番上へ</span>
			</a>
		</div>

		<div class="site-footer__meta">
			<p>© {profileDisplayName}</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-block-start: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-surface) 82%, transparent);
	}

	.site-footer__inner {
		inline-size: min(calc(100% - var(--space-4)), 72rem);
		margin-inline: auto;
		padding-block: clamp(var(--space-3), 5vw, var(--space-5));
	}

	.site-footer__main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-2) var(--space-3);
	}

	.site-footer__site-nav {
		display: flex;
		min-inline-size: 0;
		align-items: center;
		gap: var(--space-3);
	}

	.site-footer__site-nav .social-links {
		margin-block-start: 0;
	}

	.site-footer__divider {
		inline-size: 2px;
		block-size: 1.75rem;
		background: color-mix(in srgb, var(--color-text) 55%, var(--color-canvas));
	}

	.site-footer__nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
	}

	.site-footer__nav a,
	.site-footer__top {
		display: inline-flex;
		block-size: 2.75rem;
		align-items: center;
		color: var(--color-text-muted);
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}

	.site-footer__top {
		justify-self: end;
		gap: 0.4rem;
		padding-inline: 0;
		border: 0;
		background: transparent;
	}

	.site-footer__top-icon {
		flex: none;
		inline-size: 1rem;
		block-size: 1rem;
	}

	.site-footer__nav a:hover,
	.site-footer__top:hover {
		color: var(--color-accent);
	}

	.site-footer__nav a:focus-visible,
	.site-footer__top:focus-visible {
		border-radius: var(--radius-small);
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.site-footer__meta {
		margin-block-start: var(--space-3);
		padding-block-start: var(--space-3);
		border-block-start: 1px solid var(--color-border);
	}

	.site-footer__meta p {
		margin: 0;
		font-size: 0.75rem;
	}

	@media (max-width: 30rem) {
		.site-footer__inner {
			inline-size: min(calc(100% - var(--space-3)), 72rem);
		}

		.site-footer__meta {
			margin-block-start: var(--space-2);
		}

		.site-footer__main {
			grid-template-columns: 1fr;
			align-items: center;
		}

		.site-footer__top {
			justify-self: end;
		}
	}
</style>
