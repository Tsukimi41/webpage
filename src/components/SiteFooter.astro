---
import { createSitePath } from '../config/site';
import { profileDisplayName } from '../data/profile';
import BackToTopLink from './BackToTopLink.astro';
import SocialLinks from './SocialLinks.astro';

const homeHref = createSitePath(import.meta.env.BASE_URL, '/');
const profileHref = createSitePath(import.meta.env.BASE_URL, '/profile/');
const articlesHref = createSitePath(import.meta.env.BASE_URL, '/articles/');
const rssHref = createSitePath(import.meta.env.BASE_URL, '/rss.xml');
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__main">
			<div class="site-footer__site-nav">
				<SocialLinks accessibleLabel="外部プロフィール" variant="footer" />
				<span class="site-footer__divider" aria-hidden="true"></span>
				<nav class="site-footer__nav" aria-label="フッターメニュー">
					<a href={homeHref}>Home</a>
					<a href={profileHref}>Profile</a>
					<a href={articlesHref}>Articles</a>
					<a href={rssHref}>RSS</a>
				</nav>
			</div>
			<BackToTopLink />
		</div>

		<div class="site-footer__meta">
			<p>© {profileDisplayName}</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-block-start: 1px solid var(--color-border);
		background: var(--color-surface-raised);
	}

	.site-footer__inner {
		inline-size: min(calc(100% - var(--space-4)), var(--content-width));
		margin-inline: auto;
		padding-block: clamp(var(--space-3), 5vw, var(--space-5));
	}

	.site-footer__main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-2) var(--space-3);
	}

	.site-footer__site-nav {
		--site-footer-control-block-size: 2.75rem;

		display: flex;
		min-inline-size: 0;
		align-items: center;
		gap: var(--space-3);
	}

	.site-footer__site-nav :global(.social-links--footer) {
		display: flex;
		min-block-size: var(--site-footer-control-block-size);
		align-items: center;
		align-self: center;
		margin-block-start: 0;
		animation: none;
	}

	.site-footer__site-nav :global(.social-links--footer .social-links__list) {
		align-items: center;
	}

	.site-footer__site-nav :global(.social-links--footer .social-links__list > li) {
		display: flex;
	}

	.site-footer__site-nav :global(.social-links--footer .social-links__link) {
		block-size: var(--site-footer-control-block-size);
		min-block-size: var(--site-footer-control-block-size);
	}

	.site-footer__divider {
		inline-size: 2px;
		block-size: 1.75rem;
		background: color-mix(in srgb, var(--color-text) 55%, var(--color-canvas));
	}

	.site-footer__nav {
		display: flex;
		min-block-size: var(--site-footer-control-block-size);
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
	}

	.site-footer__nav a {
		display: inline-flex;
		block-size: var(--site-footer-control-block-size);
		align-items: center;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.site-footer__nav a:hover {
		color: var(--color-accent-alt);
	}

	.site-footer__nav a:focus-visible {
		border-radius: var(--radius-small);
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.site-footer__meta {
		margin-block-start: var(--space-3);
		padding-block-start: var(--space-3);
		border-block-start: 1px solid var(--color-border);
	}

	.site-footer__meta p {
		margin: 0;
		font-size: 0.75rem;
	}

	@media (max-width: 30rem) {
		.site-footer__inner {
			inline-size: min(calc(100% - var(--space-3)), var(--content-width));
		}

		.site-footer__meta {
			margin-block-start: var(--space-2);
		}

		.site-footer__main {
			grid-template-columns: 1fr;
			align-items: center;
		}

	}
</style>
