---
import type { ProjectDefinition } from '../content/projects';
import SkillLabels from './SkillLabels.astro';

interface Props {
	project: Readonly<ProjectDefinition>;
	headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<article class="project-card" data-content-state={project.state}>
	<header class="project-card__header">
		<p class="project-card__period">{project.period}</p>
		<Heading class="project-card__title">
			<a href={`/projects/${project.slug}/`}>
				<span>{project.title}</span>
				<span class="project-card__arrow" aria-hidden="true">↗</span>
			</a>
		</Heading>
	</header>

	<p class="project-card__summary">{project.summary}</p>

	<div class="project-card__details">
		<SkillLabels skillIds={project.skillIds} />
	</div>
</article>

<style>
	.project-card {
		position: relative;
		display: flex;
		min-inline-size: 0;
		min-block-size: 100%;
		flex-direction: column;
		padding: clamp(var(--space-3), 4vw, var(--space-4));
		border: 1px solid var(--color-border);
		border-radius: 0;
		background: color-mix(in srgb, var(--color-surface) 94%, transparent);
		box-shadow: 0.35rem 0.35rem 0 var(--color-shadow);
	}

	.project-card::before {
		position: absolute;
		inset-block: var(--space-3);
		inset-inline-start: 0;
		inline-size: 0.1875rem;
		background: var(--color-accent);
		content: '';
	}

	.project-card__header,
	.project-card__details {
		min-inline-size: 0;
	}

	.project-card__period {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.project-card__title {
		margin-block: var(--space-1) 0;
		color: var(--color-text);
		font-size: clamp(1.25rem, 4vw, 1.65rem);
		line-height: 1.4;
		overflow-wrap: anywhere;
		font-family: var(--font-mono);
	}

	.project-card__title a {
		display: inline-flex;
		align-items: baseline;
		gap: var(--space-1);
		color: var(--color-text);
		text-decoration-color: transparent;
		text-decoration-thickness: 0.1em;
		text-underline-offset: 0.2em;
		transition:
			color 180ms ease,
			text-decoration-color 180ms ease;
	}

	.project-card__title a:visited {
		color: var(--color-text);
	}

	.project-card__title a:hover {
		color: var(--color-accent-alt);
		text-decoration-color: currentColor;
	}

	.project-card__title a:focus-visible {
		border-radius: var(--radius-small);
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.project-card__arrow {
		flex: 0 0 auto;
		color: var(--color-accent);
		font-size: 0.75em;
		transition: transform 180ms ease;
	}

	.project-card__title a:is(:hover, :focus-visible) .project-card__arrow {
		transform: translate(0.15em, -0.15em);
	}

	.project-card__summary {
		overflow-wrap: anywhere;
	}

	.project-card__summary {
		margin-block-start: var(--space-2);
	}

	.project-card__details {
		margin-block-start: auto;
		padding-block-start: var(--space-4);
	}

	@supports not (background: color-mix(in srgb, black, white)) {
		.project-card {
			background: var(--color-surface);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card__title a,
		.project-card__arrow {
			transition: none;
		}

		.project-card__title a:is(:hover, :focus-visible) .project-card__arrow {
			transform: none;
		}
	}
</style>
