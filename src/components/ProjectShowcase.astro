---
import type { ProjectDefinition } from '../content/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
	projects: readonly Readonly<ProjectDefinition>[];
	headingId?: string;
}

const { projects, headingId = 'featured-projects-title' } = Astro.props;
const includesMockData = projects.some((project) => project.state === 'mock');
---

{
	projects.length > 0 && (
		<section class="project-showcase" aria-labelledby={headingId}>
			<header class="project-showcase__header">
				<h2 id={headingId}>代表プロジェクト</h2>
				{includesMockData && <p class="project-showcase__state">モックデータ</p>}
			</header>

			<ul class="project-showcase__grid" role="list">
				{projects.map((project) => <li><ProjectCard project={project} /></li>)}
			</ul>
		</section>
	)
}

<style>
	.project-showcase {
		padding-block: clamp(var(--space-5), 10vw, 7rem);
	}

	.project-showcase__header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2);
		margin-block-end: var(--space-3);
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--color-border);
	}

	.project-showcase h2 {
		margin: 0;
		color: var(--color-text);
		font-size: clamp(1.5rem, 5vw, 2rem);
		line-height: 1.3;
	}

	.project-showcase__state {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		white-space: nowrap;
	}

	.project-showcase__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-showcase__grid > li {
		min-inline-size: 0;
	}

	@media (max-width: 30rem) {
		.project-showcase__header {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
