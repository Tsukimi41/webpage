---
import { Icon } from 'astro-icon/components';
import type { SkillVisualDefinition } from '../content/skills';

interface Props {
	visual: Readonly<SkillVisualDefinition>;
	label: string;
}

const { visual, label } = Astro.props;
const fallbackText = visual.fallbackText ?? (visual.kind === 'text' ? visual.text : label);
---

<span
	class="skill-visual"
	data-skill-visual
	data-visual-kind={visual.kind}
	data-visual-state={visual.kind === 'image' ? 'loading' : 'ready'}
>
	<span class="skill-visual__fallback" aria-hidden="true">{fallbackText}</span>
	{
		visual.kind === 'icon' ? (
			<Icon class="skill-visual__icon" name={visual.name} size="100%" aria-hidden="true" />
		) : visual.kind === 'image' ? (
			<img
				class="skill-visual__image"
				data-skill-visual-image
				src={visual.src}
				alt={visual.alt}
				width={visual.width}
				height={visual.height}
				loading="lazy"
				decoding="async"
				referrerpolicy={visual.src.startsWith('https://') ? 'no-referrer' : undefined}
			/>
		) : (
			<span class="skill-visual__text" aria-hidden="true">{visual.text}</span>
		)
	}
</span>

<script>
	const synchronizeSkillImage = (image: HTMLImageElement): void => {
		const visual = image.closest<HTMLElement>('[data-skill-visual]');
		if (!visual) return;

		const synchronize = (): void => {
			visual.dataset.visualState = image.complete && image.naturalWidth > 0
				? 'ready'
				: image.complete
					? 'fallback'
					: 'loading';
		};

		image.addEventListener('load', synchronize, { once: true });
		image.addEventListener('error', synchronize, { once: true });
		synchronize();
	};

	document.querySelectorAll<HTMLImageElement>('[data-skill-visual-image]').forEach(
		synchronizeSkillImage,
	);
</script>

<style>
	.skill-visual {
		position: relative;
		display: grid;
		place-items: center;
		inline-size: 100%;
		block-size: 100%;
	}

	.skill-visual__icon,
	.skill-visual__image,
	.skill-visual__text,
	.skill-visual__fallback {
		grid-area: 1 / 1;
	}

	.skill-visual__icon,
	.skill-visual__image {
		display: block;
		inline-size: 100%;
		block-size: 100%;
		object-fit: contain;
	}

	.skill-visual__text,
	.skill-visual__fallback {
		display: grid;
		place-items: center;
		min-inline-size: 100%;
		min-block-size: 100%;
		font-size: clamp(0.7rem, 2.5vw, 1rem);
		font-weight: 900;
		line-height: 1.1;
		text-align: center;
		overflow-wrap: anywhere;
	}

	.skill-visual__fallback {
		font-size: clamp(0.58rem, 2vw, 0.9rem);
	}

	.skill-visual[data-visual-kind='icon'] .skill-visual__fallback,
	.skill-visual[data-visual-kind='text'] .skill-visual__fallback,
	.skill-visual[data-visual-state='ready'] .skill-visual__fallback {
		display: none;
	}

	.skill-visual[data-visual-state='loading'] .skill-visual__image,
	.skill-visual[data-visual-state='fallback'] .skill-visual__image {
		opacity: 0;
	}
</style>
