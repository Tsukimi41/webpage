---
import { createSitePath } from '../config/site';
import type { ArticleIndexItem, ArticleTopicFacet } from '../content/articles';
import ArticleIndexCard from './ArticleIndexCard.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	items: readonly Readonly<ArticleIndexItem>[];
	topics: readonly Readonly<ArticleTopicFacet>[];
}

const { items, topics } = Astro.props;
const articlesHref = createSitePath(import.meta.env.BASE_URL, '/articles/');
---

<section class="article-explorer" data-article-explorer data-enhanced="false" aria-labelledby="article-results-title">
	<form class="article-explorer__controls" data-search-form action={articlesHref} method="get" role="search">
		<div class="article-explorer__search-field">
			<label for="article-search">記事を検索</label>
			<input
				id="article-search"
				name="q"
				type="search"
				maxlength="80"
				placeholder="キーワードを入力"
				enterkeyhint="search"
				aria-describedby="article-search-help"
				autocomplete="off"
				aria-controls="article-results"
				data-search-input
			/>
		</div>

		<p id="article-search-help" class="article-explorer__help">タイトル・概要・技術・タグから検索できます。空白で区切ると、すべての言葉を含む記事を探します。</p>
		<button class="article-explorer__submit" type="submit">検索結果を見る</button>

		<fieldset class="article-explorer__kind" data-kind-controls>
			<legend>記事の種類</legend>
			<div>
				<button type="button" data-kind="all" aria-pressed="true">すべて</button>
				<button type="button" data-kind="project" aria-pressed="false">プロジェクト</button>
				<button type="button" data-kind="blog" aria-pressed="false">記事</button>
			</div>
		</fieldset>

		<div class="article-explorer__topic-field">
			<label for="article-topic">技術・タグ</label>
			<select id="article-topic" name="topic" data-topic-select>
				<option value="">すべて</option>
				{topics.map((topic) => (
					<option value={topic.id}>{topic.label}（{topic.count}）</option>
				))}
			</select>
		</div>

		<button class="article-explorer__reset" type="reset" data-search-reset>条件をクリア</button>
	</form>

	<noscript>
		<p class="article-explorer__noscript">検索操作なしで、すべての記事を表示しています。</p>
	</noscript>

	<div class="article-explorer__summary" data-results-summary tabindex="-1">
		<SectionHeading id="article-results-title" label="検索結果" size="section" />
		<p data-result-count role="status" aria-live="polite" aria-atomic="true">全{items.length}件</p>
		<p class="article-explorer__range" data-results-range hidden></p>
	</div>

	{items.length > 0 ? (
		<ul id="article-results" class="article-explorer__list" role="list">
			{items.map((item) => (
				<li
					data-article-item
					data-kind={item.sourceKind}
					data-search={item.searchText}
					data-topics={item.topicIds.join(' ')}
				>
					<ArticleIndexCard item={item} />
				</li>
			))}
		</ul>
	) : (
		<p class="article-explorer__empty">表示できる記事はありません。</p>
	)}

	<p class="article-explorer__empty" data-no-results hidden>条件に一致する記事はありません。キーワードを短くするか、「条件をクリア」で一覧に戻れます。</p>
	<nav class="article-explorer__pagination" data-pagination aria-label="検索結果のページ切り替え" hidden>
		<p data-page-status role="status" aria-atomic="true"></p>
		<button type="button" data-page-previous aria-controls="article-results">前のページ</button>
		<button type="button" data-page-next aria-controls="article-results">次のページ</button>
	</nav>
</section>

<script>
	import {
		parseArticleSearchKind,
		type ArticleSearchKind,
	} from '../content/articles/search.ts';
	import { createArticleSearchCache } from '../scripts/article-search-cache';

	function initializeArticleExplorer(root: HTMLElement): void {
		if (root.dataset.enhanced === 'true') return;

		const form = root.querySelector<HTMLFormElement>('[data-search-form]');
		const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
		const topicSelect = root.querySelector<HTMLSelectElement>('[data-topic-select]');
		const kindButtons = [...root.querySelectorAll<HTMLButtonElement>('button[data-kind]')];
		const itemElements = [...root.querySelectorAll<HTMLElement>('[data-article-item]')];
		const resultCount = root.querySelector<HTMLElement>('[data-result-count]');
		const noResults = root.querySelector<HTMLElement>('[data-no-results]');
		const pagination = root.querySelector<HTMLElement>('[data-pagination]');
		const pageStatus = root.querySelector<HTMLElement>('[data-page-status]');
		const pagePrevious = root.querySelector<HTMLButtonElement>('[data-page-previous]');
		const pageNext = root.querySelector<HTMLButtonElement>('[data-page-next]');
		const resultsRange = root.querySelector<HTMLElement>('[data-results-range]');

		if (!form || !searchInput || !topicSelect || !resultCount || !noResults || !pagination || !pageStatus || !pagePrevious || !pageNext) return;
		const search = createArticleSearchCache(itemElements.map(element => ({
			element,
			id: element.dataset.articleItem ?? '',
			sourceKind: element.dataset.kind === 'project' ? 'project' as const : 'blog' as const,
			searchText: element.dataset.search ?? '',
			topicIds: (element.dataset.topics ?? '').split(' ').filter(Boolean),
		})));
		const setText = (element: HTMLElement, value: string): void => {
			if (element.textContent !== value) element.textContent = value;
		};

		let selectedKind: ArticleSearchKind = 'all';
		const url = new URL(window.location.href);
		const pageSize = 6;
		const requestedPage = Number(url.searchParams.get('page'));
		let currentPage = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
		searchInput.value = url.searchParams.get('q')?.slice(0, 80) ?? '';
		selectedKind = parseArticleSearchKind(url.searchParams.get('kind'));
		const requestedTopic = url.searchParams.get('topic') ?? '';
		topicSelect.value = [...topicSelect.options].some((option) => option.value === requestedTopic)
			? requestedTopic
			: '';

		const update = (replaceUrl = true): void => {
			const criteria = {
				query: searchInput.value,
				kind: selectedKind,
				topicId: topicSelect.value || undefined,
			};
			const matches = search(criteria);
			const visibleCount = matches.length;
			const totalPages = Math.max(1, Math.ceil(visibleCount / pageSize));
			currentPage = Math.min(currentPage, totalPages);
			const start = (currentPage - 1) * pageSize;
			const visibleItems = new Set(matches.slice(start, start + pageSize).map(item => item.element));
			for (const element of itemElements) {
				const hidden = !visibleItems.has(element);
				if (element.hidden !== hidden) element.hidden = hidden;
			}
			if (pagination.hidden !== (totalPages <= 1)) pagination.hidden = totalPages <= 1;
			if (pagePrevious.disabled !== (currentPage === 1)) pagePrevious.disabled = currentPage === 1;
			if (pageNext.disabled !== (currentPage === totalPages)) pageNext.disabled = currentPage === totalPages;
			setText(pageStatus, visibleCount === 0 ? '' : `${start + 1}〜${Math.min(start + pageSize, visibleCount)}件を表示（${currentPage} / ${totalPages}ページ）`);
			if (resultsRange) {
				if (resultsRange.hidden !== (totalPages <= 1)) resultsRange.hidden = totalPages <= 1;
				setText(resultsRange, pageStatus.textContent ?? '');
			}

			for (const button of kindButtons) {
				const pressed = String(button.dataset.kind === selectedKind);
				if (button.getAttribute('aria-pressed') !== pressed) button.setAttribute('aria-pressed', pressed);
			}

			setText(resultCount, `${visibleCount}件 / 全${itemElements.length}件`);
			if (noResults.hidden !== (visibleCount !== 0)) noResults.hidden = visibleCount !== 0;

			if (replaceUrl) {
				const nextUrl = new URL(window.location.href);
				const query = searchInput.value.trim();

				query ? nextUrl.searchParams.set('q', query) : nextUrl.searchParams.delete('q');
				selectedKind === 'all'
					? nextUrl.searchParams.delete('kind')
					: nextUrl.searchParams.set('kind', selectedKind);
				topicSelect.value
					? nextUrl.searchParams.set('topic', topicSelect.value)
					: nextUrl.searchParams.delete('topic');
				currentPage > 1 ? nextUrl.searchParams.set('page', String(currentPage)) : nextUrl.searchParams.delete('page');
				if (nextUrl.href !== window.location.href) window.history.replaceState(null, '', nextUrl);
			}
		};
		let searchTimer: ReturnType<typeof setTimeout> | undefined;
		let composing = false;
		const cancelSearch = (): void => {
			clearTimeout(searchTimer);
			searchTimer = undefined;
		};
		const updateFilters = (): void => {
			cancelSearch();
			currentPage = 1;
			update();
		};
		const scheduleSearch = (): void => {
			cancelSearch();
			searchTimer = setTimeout(updateFilters, 120);
		};
		const focusResults = (): void => {
			const summary = root.querySelector<HTMLElement>('[data-results-summary]');
			summary?.focus();
			summary?.scrollIntoView({ block: 'start', behavior: 'instant' });
		};

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			updateFilters();
			focusResults();
		});
		searchInput.addEventListener('input', (event) => {
			if (!composing && (!(event instanceof InputEvent) || !event.isComposing)) scheduleSearch();
		});
		searchInput.addEventListener('compositionstart', () => {
			composing = true;
			cancelSearch();
		});
		searchInput.addEventListener('compositionend', () => {
			composing = false;
			scheduleSearch();
		});
		topicSelect.addEventListener('change', updateFilters);
		form.addEventListener('reset', () => {
			cancelSearch();
			window.setTimeout(() => {
				selectedKind = 'all';
				updateFilters();
			}, 0);
		});

		for (const button of kindButtons) {
			button.addEventListener('click', () => {
				selectedKind = parseArticleSearchKind(button.dataset.kind);
				updateFilters();
			});
		}
		pagePrevious.addEventListener('click', () => {
			if (searchTimer !== undefined) updateFilters();
			currentPage = Math.max(1, currentPage - 1);
			update();
			focusResults();
		});
		pageNext.addEventListener('click', () => {
			if (searchTimer !== undefined) updateFilters();
			currentPage += 1;
			update();
			focusResults();
		});

		root.dataset.enhanced = 'true';
		window.addEventListener('pagehide', cancelSearch, { once: true });
		update(false);
	}

	document.querySelectorAll<HTMLElement>('[data-article-explorer]').forEach(initializeArticleExplorer);
</script>

<style>
	.article-explorer {
		container: article-explorer / inline-size;
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
	}

	.article-explorer[data-enhanced='false'] .article-explorer__controls {
		display: none;
	}

	.article-explorer__controls {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		min-inline-size: 0;
		max-inline-size: 100%;
		align-items: end;
		gap: var(--space-2);
		margin-block-end: var(--space-4);
		padding: clamp(var(--space-2), 4vw, var(--space-3));
		border-block: 1px solid var(--color-border);
		background: transparent;
	}

	.article-explorer__search-field,
	.article-explorer__topic-field {
		display: grid;
		min-inline-size: 0;
		gap: 0.35rem;
	}

	.article-explorer label,
	.article-explorer legend {
		color: var(--color-text-muted);
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: 0.06em;
	}

	.article-explorer input,
	.article-explorer select,
	.article-explorer button {
		min-block-size: 3rem;
		border: 1px solid var(--color-control-border);
		border-radius: var(--radius-small);
		background: var(--color-canvas);
		color: var(--color-text);
		font: inherit;
	}

	.article-explorer input,
	.article-explorer select {
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
		padding-inline: 0.75rem;
	}

	.article-explorer input::placeholder {
		color: var(--color-text-muted);
		opacity: 0.8;
	}

	.article-explorer__kind {
		min-inline-size: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	.article-explorer__kind > div {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
		gap: 0.5rem;
		margin-block-start: 0.35rem;
	}

	.article-explorer__kind button {
		padding-inline: 0.55rem;
		font-size: 1rem;
		font-weight: 800;
		cursor: pointer;
	}

	.article-explorer__kind button + button {
		border-inline-start: 1px solid var(--color-control-border);
	}

	.article-explorer__kind button[aria-pressed='true'] {
		border-color: var(--color-accent);
		background: var(--color-accent);
		color: var(--color-canvas);
		text-decoration: underline;
	}

	.article-explorer__reset {
		padding-inline: var(--space-2);
		font-size: 0.875rem;
		font-weight: 800;
		cursor: pointer;
	}

	.article-explorer input:focus-visible,
	.article-explorer select:focus-visible,
	.article-explorer button:focus-visible {
		position: relative;
		z-index: 1;
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.article-explorer__summary {
		flex-wrap: wrap;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2);
		margin-block-end: var(--space-3);
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--color-border);
	}

	.article-explorer__summary p {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 700;
	}
	.article-explorer__summary .article-explorer__range { flex-basis: 100%; font-size: 1rem; }

	.article-explorer__list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.article-explorer__list > li {
		min-inline-size: 0;
	}

	.article-explorer__empty,
	.article-explorer__noscript {
		margin: 0;
		padding: var(--space-4);
		border: 1px dashed var(--color-border);
		text-align: center;
	}

	.article-explorer__noscript {
		margin-block-end: var(--space-3);
	}

	.article-explorer__help { margin: 0; font-size: 1rem; }
	.article-explorer__submit { padding: 0.6rem 1rem; font-weight: 700; }
	.article-explorer__pagination {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2);
		margin-block-start: var(--space-3);
	}
	.article-explorer__pagination p { grid-column: 1 / -1; margin: 0; }
	.article-explorer__pagination button { padding: 0.5rem; }
	.article-explorer__pagination button:disabled { color: var(--color-text-muted); border-style: dashed; cursor: default; }
	@container article-explorer (min-width: 42rem) {
		.article-explorer__controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.article-explorer__search-field, .article-explorer__help { grid-column: 1 / -1; }
	}
</style>
