---
import type { ArticleIndexItem, ArticleTopicFacet } from '../content/articles';
import ArticleIndexCard from './ArticleIndexCard.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	items: readonly Readonly<ArticleIndexItem>[];
	topics: readonly Readonly<ArticleTopicFacet>[];
}

const { items, topics } = Astro.props;
---

<section class="article-explorer" data-article-explorer data-enhanced="false" aria-labelledby="article-results-title">
	<form class="article-explorer__controls" data-search-form action="/articles/" method="get" role="search">
		<div class="article-explorer__search-field">
			<label for="article-search">記事を検索</label>
			<input
				id="article-search"
				name="q"
				type="search"
				maxlength="80"
				placeholder=""
				autocomplete="off"
				aria-controls="article-results"
				data-search-input
			/>
		</div>

		<fieldset class="article-explorer__kind" data-kind-controls>
			<legend>記事の種類</legend>
			<div>
				<button type="button" data-kind="all" aria-pressed="true">すべて</button>
				<button type="button" data-kind="project" aria-pressed="false">プロジェクト</button>
				<button type="button" data-kind="blog" aria-pressed="false">記事</button>
			</div>
		</fieldset>

		<div class="article-explorer__topic-field">
			<label for="article-topic">技術・タグ</label>
			<select id="article-topic" name="topic" data-topic-select>
				<option value="">すべて</option>
				{topics.map((topic) => (
					<option value={topic.id}>{topic.label}（{topic.count}）</option>
				))}
			</select>
		</div>

		<button class="article-explorer__reset" type="reset" data-search-reset>条件をクリア</button>
	</form>

	<noscript>
		<p class="article-explorer__noscript">検索操作なしで、すべての記事を表示しています。</p>
	</noscript>

	<div class="article-explorer__summary">
		<SectionHeading id="article-results-title" label="検索結果" size="section" />
		<p data-result-count aria-live="polite">全{items.length}件</p>
	</div>

	{items.length > 0 ? (
		<ul id="article-results" class="article-explorer__list" role="list">
			{items.map((item) => (
				<li
					data-article-item
					data-kind={item.sourceKind}
					data-search={item.searchText}
					data-topics={item.topicIds.join(' ')}
				>
					<ArticleIndexCard item={item} />
				</li>
			))}
		</ul>
	) : (
		<p class="article-explorer__empty">表示できる記事はありません。</p>
	)}

	<p class="article-explorer__empty" data-no-results hidden>条件に一致する記事はありません。</p>
</section>

<script>
	import {
		matchesArticleSearch,
		parseArticleSearchKind,
		type ArticleSearchKind,
	} from '../content/articles/search.ts';

	function initializeArticleExplorer(root: HTMLElement): void {
		if (root.dataset.enhanced === 'true') return;

		const form = root.querySelector<HTMLFormElement>('[data-search-form]');
		const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
		const topicSelect = root.querySelector<HTMLSelectElement>('[data-topic-select]');
		const kindButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-kind]')];
		const itemElements = [...root.querySelectorAll<HTMLElement>('[data-article-item]')];
		const resultCount = root.querySelector<HTMLElement>('[data-result-count]');
		const noResults = root.querySelector<HTMLElement>('[data-no-results]');

		if (!form || !searchInput || !topicSelect || !resultCount || !noResults) return;

		let selectedKind: ArticleSearchKind = 'all';
		const url = new URL(window.location.href);
		searchInput.value = url.searchParams.get('q')?.slice(0, 80) ?? '';
		selectedKind = parseArticleSearchKind(url.searchParams.get('kind'));
		const requestedTopic = url.searchParams.get('topic') ?? '';
		topicSelect.value = [...topicSelect.options].some((option) => option.value === requestedTopic)
			? requestedTopic
			: '';

		const update = (replaceUrl = true): void => {
			const criteria = {
				query: searchInput.value,
				kind: selectedKind,
				topicId: topicSelect.value || undefined,
			};
			let visibleCount = 0;

			for (const element of itemElements) {
				const matches = matchesArticleSearch(
					{
						id: element.dataset.articleItem ?? '',
						sourceKind: element.dataset.kind === 'project' ? 'project' : 'blog',
						searchText: element.dataset.search ?? '',
						topicIds: (element.dataset.topics ?? '').split(' ').filter(Boolean),
					},
					criteria,
				);

				element.hidden = !matches;
				if (matches) visibleCount += 1;
			}

			for (const button of kindButtons) {
				button.setAttribute('aria-pressed', String(button.dataset.kind === selectedKind));
			}

			resultCount.textContent = `${visibleCount}件 / 全${itemElements.length}件`;
			noResults.hidden = visibleCount !== 0;

			if (replaceUrl) {
				const nextUrl = new URL(window.location.href);
				const query = searchInput.value.trim();

				query ? nextUrl.searchParams.set('q', query) : nextUrl.searchParams.delete('q');
				selectedKind === 'all'
					? nextUrl.searchParams.delete('kind')
					: nextUrl.searchParams.set('kind', selectedKind);
				topicSelect.value
					? nextUrl.searchParams.set('topic', topicSelect.value)
					: nextUrl.searchParams.delete('topic');
				window.history.replaceState(null, '', nextUrl);
			}
		};

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			update();
		});
		searchInput.addEventListener('input', () => update());
		topicSelect.addEventListener('change', () => update());
		form.addEventListener('reset', () => {
			window.setTimeout(() => {
				selectedKind = 'all';
				update();
			}, 0);
		});

		for (const button of kindButtons) {
			button.addEventListener('click', () => {
				selectedKind = parseArticleSearchKind(button.dataset.kind);
				update();
			});
		}

		root.dataset.enhanced = 'true';
		update(false);
	}

	document.querySelectorAll<HTMLElement>('[data-article-explorer]').forEach(initializeArticleExplorer);
</script>

<style>
	.article-explorer {
		container: article-explorer / inline-size;
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
	}

	.article-explorer[data-enhanced='false'] .article-explorer__controls {
		display: none;
	}

	.article-explorer__controls {
		display: grid;
		grid-template-columns: minmax(14rem, 1.5fr) minmax(15rem, 1fr) minmax(10rem, 0.75fr) auto;
		min-inline-size: 0;
		max-inline-size: 100%;
		align-items: end;
		gap: var(--space-2);
		margin-block-end: var(--space-4);
		padding: clamp(var(--space-2), 4vw, var(--space-3));
		border-block: 1px solid var(--color-border);
		background: transparent;
	}

	.article-explorer__search-field,
	.article-explorer__topic-field {
		display: grid;
		min-inline-size: 0;
		gap: 0.35rem;
	}

	.article-explorer label,
	.article-explorer legend {
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.06em;
	}

	.article-explorer input,
	.article-explorer select,
	.article-explorer button {
		min-block-size: 2.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		background: var(--color-canvas);
		color: var(--color-text);
		font: inherit;
	}

	.article-explorer input,
	.article-explorer select {
		inline-size: 100%;
		min-inline-size: 0;
		max-inline-size: 100%;
		padding-inline: 0.75rem;
	}

	.article-explorer input::placeholder {
		color: var(--color-text-muted);
		opacity: 0.8;
	}

	.article-explorer__kind {
		min-inline-size: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	.article-explorer__kind > div {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-block-start: 0.35rem;
	}

	.article-explorer__kind button {
		padding-inline: 0.55rem;
		font-size: 0.75rem;
		font-weight: 800;
		cursor: pointer;
	}

	.article-explorer__kind button + button {
		border-inline-start: 0;
	}

	.article-explorer__kind button[aria-pressed='true'] {
		border-color: var(--color-accent);
		background: var(--color-surface-raised);
		color: var(--color-accent);
	}

	.article-explorer__reset {
		padding-inline: var(--space-2);
		font-size: 0.8rem;
		font-weight: 800;
		cursor: pointer;
	}

	.article-explorer input:focus-visible,
	.article-explorer select:focus-visible,
	.article-explorer button:focus-visible {
		position: relative;
		z-index: 1;
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.article-explorer__summary {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2);
		margin-block-end: var(--space-3);
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--color-border);
	}

	.article-explorer__summary p {
		margin: 0;
		font-size: 0.8125rem;
		font-weight: 700;
	}

	.article-explorer__list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.article-explorer__list > li {
		min-inline-size: 0;
	}

	.article-explorer__empty,
	.article-explorer__noscript {
		margin: 0;
		padding: var(--space-4);
		border: 1px dashed var(--color-border);
		text-align: center;
	}

	.article-explorer__noscript {
		margin-block-end: var(--space-3);
	}

	@container article-explorer (max-width: 64rem) {
		.article-explorer__controls {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@container article-explorer (max-width: 42rem) {
		.article-explorer__controls,
		.article-explorer__list {
			grid-template-columns: minmax(0, 1fr);
		}

		.article-explorer__reset {
			justify-self: start;
		}
	}
</style>
