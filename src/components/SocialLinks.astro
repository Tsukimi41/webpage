---
import { Icon } from 'astro-icon/components';
import { socialLinks } from '../data/social-links';

interface Props {
	accessibleLabel?: string;
	variant?: 'default' | 'footer';
}

const { accessibleLabel = '外部プロフィール', variant = 'default' } = Astro.props;
---

<nav
	class:list={['social-links', { 'social-links--footer': variant === 'footer' }]}
	aria-label={accessibleLabel}
>
	<ul class="social-links__list" role="list">
		{
			socialLinks.map((link) => (
				<li>
					<a
						class="social-links__link"
						href={link.href}
						aria-label={`${link.label}（新しいタブで開く）`}
						target="_blank"
						rel="me noopener noreferrer"
					>
						<Icon
							class="social-links__icon"
							name={link.icon}
							size="1.375rem"
							aria-hidden="true"
						/>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.social-links {
		margin-block-start: var(--space-3);
		animation: social-links-enter 420ms 260ms ease-out both;
	}

	.social-links__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.social-links__list > li {
		display: flex;
	}

	.social-links__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 2.75rem;
		min-block-size: 2.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		background: var(--color-surface-raised);
		color: var(--color-text-muted);
		text-decoration: none;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease,
			transform 160ms ease;
	}

	.social-links__link:hover {
		border-color: var(--color-accent);
		background: var(--color-accent);
		color: var(--color-canvas);
		transform: translateY(-0.125rem);
	}

	.social-links__link:focus-visible {
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.social-links__icon {
		flex: none;
	}

	@keyframes social-links-enter {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.social-links,
		.social-links__link {
			animation: none;
			transition: none;
		}

		.social-links__link:hover {
			transform: none;
		}
	}
</style>
