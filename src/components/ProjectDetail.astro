---
import type { ProjectDefinition } from '../content/projects';
import ContentStateNotice from './ContentStateNotice.astro';
import SkillLabels from './SkillLabels.astro';

interface Props {
	project: Readonly<ProjectDefinition>;
}

const { project } = Astro.props;
const hasMockData = project.state === 'mock';
---

<article class="project-detail">
	<header class="project-detail__header">
		<div class="project-detail__heading">
			<p class="project-detail__period">{project.period}</p>
			<h1>{project.title}</h1>
			<p class="project-detail__summary">{project.summary}</p>
		</div>
		<ContentStateNotice hasMockData={hasMockData} />
	</header>

	<div class="project-detail__body">
		<div class="project-detail__sections">
			{project.detailSections.map((section) => (
				<section aria-labelledby={`${project.slug}-${section.id}`}>
					<h2 id={`${project.slug}-${section.id}`}>{section.title}</h2>
					{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				</section>
			))}
		</div>

		<aside class="project-detail__metadata" aria-label="プロジェクト情報">
			<dl>
				<div>
					<dt>担当</dt>
					<dd>{project.role}</dd>
				</div>
				<div>
					<dt>使用技術</dt>
					<dd>
						<SkillLabels skillIds={project.skillIds} />
					</dd>
				</div>
			</dl>

			{project.links.length > 0 && (
				<nav aria-label="プロジェクト関連リンク">
					<p class="project-detail__link-label">関連リンク</p>
					<ul role="list">
						{project.links.map((link) => {
							const isExternal = link.href.startsWith('https://');

							return (
								<li>
									<a
										href={link.href}
										target={isExternal ? '_blank' : undefined}
										rel={isExternal ? 'noopener noreferrer' : undefined}
									>
										{link.label}
										{isExternal && <span class="project-detail__external-note">（新しいタブ）</span>}
									</a>
								</li>
							);
						})}
					</ul>
				</nav>
			)}
		</aside>
	</div>
</article>

<style>
	.project-detail {
		padding-block: clamp(var(--space-3), 6vw, var(--space-5));
	}

	.project-detail__header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: start;
		gap: var(--space-3);
		padding-block-end: clamp(var(--space-3), 5vw, var(--space-5));
		border-block-end: 1px solid var(--color-border);
	}

	.project-detail__heading {
		min-inline-size: 0;
	}

	.project-detail__period,
	.project-detail__link-label,
	dt {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.project-detail h1 {
		max-inline-size: 18em;
		margin-block-start: var(--space-1);
		font-size: clamp(2rem, 7vw, 3.75rem);
		overflow-wrap: anywhere;
	}

	.project-detail__summary {
		max-inline-size: 42rem;
		font-size: clamp(1rem, 2.5vw, 1.2rem);
	}

	.project-detail__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(14rem, 19rem);
		gap: clamp(var(--space-4), 8vw, var(--space-5));
		padding-block-start: clamp(var(--space-4), 7vw, var(--space-5));
	}

	.project-detail__sections {
		display: grid;
		gap: var(--space-5);
		min-inline-size: 0;
	}

	.project-detail__sections section {
		position: relative;
		padding-inline-start: var(--space-3);
	}

	.project-detail__sections section::before {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		inline-size: 0.1875rem;
		background: var(--color-accent);
		content: '';
	}

	.project-detail h2 {
		margin: 0;
		font-size: clamp(1.35rem, 4vw, 1.8rem);
		line-height: 1.4;
	}

	.project-detail__sections p {
		max-inline-size: 44rem;
		overflow-wrap: anywhere;
	}

	.project-detail__metadata {
		align-self: start;
		padding: var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		background: color-mix(in srgb, var(--color-surface) 94%, transparent);
		box-shadow: 0 1rem 2.5rem var(--color-shadow);
	}

	.project-detail__metadata dl,
	.project-detail__metadata dd,
	.project-detail__metadata ul {
		margin: 0;
		padding: 0;
	}

	.project-detail__metadata dl,
	.project-detail__metadata nav {
		display: grid;
		gap: var(--space-3);
	}

	.project-detail__metadata dl > div {
		display: grid;
		gap: var(--space-1);
	}

	.project-detail__metadata dd {
		color: var(--color-text);
		overflow-wrap: anywhere;
	}

	.project-detail__metadata nav {
		margin-block-start: var(--space-4);
		padding-block-start: var(--space-3);
		border-block-start: 1px solid var(--color-border);
	}

	.project-detail__metadata nav ul {
		display: grid;
		gap: var(--space-2);
		list-style: none;
	}

	.project-detail__metadata a {
		display: inline-flex;
		min-block-size: 2.75rem;
		align-items: center;
		color: var(--color-text);
		font-weight: 700;
		text-underline-offset: 0.25em;
	}

	.project-detail__metadata a:hover {
		color: var(--color-accent-strong);
	}

	.project-detail__metadata a:focus-visible {
		border-radius: var(--radius-small);
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.project-detail__external-note {
		font-size: 0.75rem;
		font-weight: 400;
	}

	@supports not (background: color-mix(in srgb, black, white)) {
		.project-detail__metadata {
			background: var(--color-surface);
		}
	}

	@media (max-width: 48rem) {
		.project-detail__body {
			grid-template-columns: minmax(0, 1fr);
		}

		.project-detail__metadata {
			inline-size: 100%;
		}
	}

	@media (max-width: 30rem) {
		.project-detail__header {
			grid-template-columns: minmax(0, 1fr);
		}

		.project-detail__sections section {
			padding-inline-start: var(--space-2);
		}
	}
</style>
