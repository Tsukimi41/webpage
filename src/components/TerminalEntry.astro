---
import archLogoSource from '../assets/terminal/arch.txt?raw';
import archSmallSource from '../assets/terminal/arch-small.txt?raw';
const archLogo = archLogoSource.replace(/\$\d/g, '').trimEnd();
const archSmall = archSmallSource.replace(/\$\d/g, '').trimEnd();
const palette = ['#414868', '#f7768e', '#9ece6a', '#e0af68', '#7aa2f7', '#bb9af7', '#7dcfff', '#c0caf5'];
---
<dialog class="terminal-entry" data-terminal-entry data-stage="booting" aria-label="Arch Linux — WezTerm">
  <div class="terminal-entry__shell">
    <div class="terminal-entry__tabs" aria-hidden="true">
      <span class="terminal-entry__active-tab">1: zsh</span><span class="terminal-entry__new-tab">+</span>
      <span class="terminal-entry__window-title">tsukimi41@archlinux: ~</span>
      <span class="terminal-entry__app-name">WezTerm</span>
    </div>
    <div class="terminal-entry__screen" data-terminal-screen aria-hidden="true">
      <div class="terminal-entry__boot-prompt">
        <div><span class="terminal-entry__user">tsukimi41@archlinux</span> <span class="terminal-entry__directory">~</span></div>
        <div><span class="terminal-entry__prompt">❯ </span><span class="terminal-entry__cursor"> </span></div>
      </div>
      <div class="terminal-entry__fetch-command"><span class="terminal-entry__user">tsukimi41@archlinux</span> <span class="terminal-entry__directory">~</span>
        <div><span class="terminal-entry__prompt">❯</span> fastfetch</div>
      </div>
      <div class="terminal-entry__fetch">
        <pre class="terminal-entry__arch terminal-entry__arch--full">{archLogo}</pre>
        <pre class="terminal-entry__arch terminal-entry__arch--small">{archSmall}</pre>
        <div class="terminal-entry__system">
          <div class="terminal-entry__user">tsukimi41<span class="terminal-entry__muted">@</span>archlinux</div>
          <div class="terminal-entry__muted">-------------------</div>
          <div><span class="terminal-entry__key">OS</span>: Arch Linux x86_64</div>
          <div><span class="terminal-entry__key">Kernel</span>: Linux</div>
          <div><span class="terminal-entry__key">Shell</span>: zsh</div>
          <div><span class="terminal-entry__key">WM</span>: Hyprland (Wayland)</div>
          <div><span class="terminal-entry__key">Terminal</span>: WezTerm</div>
          <div><span class="terminal-entry__key">Font</span>: JetBrains Mono</div>
          <div><span class="terminal-entry__key">Theme</span>: Tokyo Night</div>
          <div class="terminal-entry__colors">{palette.map(color => <span style={{backgroundColor:color}}>  </span>)}</div>
          <div class="terminal-entry__colors terminal-entry__colors--bright">{palette.map(color => <span style={{backgroundColor:color}}>  </span>)}</div>
        </div>
      </div>
      <div class="terminal-entry__history">
        <div><span class="terminal-entry__user">tsukimi41@archlinux</span> <span class="terminal-entry__directory">~</span></div>
        <div><span class="terminal-entry__prompt">❯</span> <span class="terminal-entry__executable">cd</span> ~/portfolio</div>
      </div>
      <div class="terminal-entry__failure" data-terminal-failure hidden>
        <div class="terminal-entry__path"><span class="terminal-entry__user">tsukimi41@archlinux</span> <span class="terminal-entry__directory">~/portfolio</span> <span class="terminal-entry__branch">git:(main)</span></div>
        <div><span class="terminal-entry__prompt">❯</span> opne ./portfolio</div>
        <div class="terminal-entry__error" data-terminal-message></div>
      </div>
      <div class="terminal-entry__input">
        <div class="terminal-entry__path"><span class="terminal-entry__user">tsukimi41@archlinux</span> <span class="terminal-entry__directory">~/portfolio</span> <span class="terminal-entry__branch">git:(main)</span></div>
        <div class="terminal-entry__command"><span class="terminal-entry__prompt">❯ </span><span data-terminal-command></span><span class="terminal-entry__cursor"> </span></div>
      </div>
      <div class="terminal-entry__confirmation" data-terminal-confirmation hidden><span class="terminal-entry__prompt">:: </span>Open ./portfolio? [Y/n] <span data-terminal-answer></span><span class="terminal-entry__cursor"> </span></div>
      <div class="terminal-entry__loader">
        <div class="terminal-entry__step" data-terminal-step><span class="terminal-entry__step-mark"></span> Resolving ./portfolio</div>
        <div class="terminal-entry__step" data-terminal-step><span class="terminal-entry__step-mark"></span> Starting browser session</div>
        <div class="terminal-entry__step" data-terminal-step><span class="terminal-entry__step-mark"></span> Opening index.html</div>
      </div>
      <div class="terminal-entry__result" data-terminal-result></div>
      <div class="terminal-entry__next-prompt"><span class="terminal-entry__prompt">❯ </span><span class="terminal-entry__cursor"> </span></div>
    </div>
  </div>
  <span class="terminal-entry__accessible-status" role="status" data-terminal-status>セッションを準備しています</span>
</dialog>

<script>
  import '../scripts/terminal-entry';
</script>

<style>
  @font-face {
    font-family: 'Terminal JetBrains Mono';
    src: url('../assets/fonts/JetBrainsMono-Regular.woff2') format('woff2');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  .terminal-entry {
    --terminal-blue: #7aa2f7;
    --terminal-cyan: #7dcfff;
    --terminal-green: #9ece6a;
    --terminal-muted: #9aa5ce;
    position: fixed; inset: 0; inline-size: 100%; max-inline-size: none; block-size: 100%; max-block-size: none;
    margin: 0; padding: clamp(8px, 3vw, 40px); border: 0; background: #101116; color: #c0caf5;
    overflow: auto; font: 400 15px/1.5 'Terminal JetBrains Mono', 'Cascadia Mono', Consolas, monospace;
    font-variant-ligatures: none; letter-spacing: 0; text-align: start; transition: opacity 800ms ease;
  }
  .terminal-entry[open] { display: flex; align-items: center; justify-content: center; }
  .terminal-entry::backdrop { background: #101116; transition: opacity 800ms ease; }
  .terminal-entry[data-stage='done'], .terminal-entry[data-stage='done']::backdrop { opacity: 0; }
  .terminal-entry__shell {
    inline-size: min(100%, 1160px); block-size: min(760px, 100%); min-block-size: 0; display: flex; flex-direction: column;
    border: 2px solid #7aa2f799; border-radius: 3px; overflow: hidden; background: #1a1b26;
    box-shadow: 0 16px 50px #0008; animation: terminal-map 180ms ease-out;
  }
  .terminal-entry__tabs { flex-shrink: 0; display: flex; align-items: center; gap: 0; block-size: 30px; background: #16161e; color: var(--terminal-muted); white-space: nowrap; font: inherit; font-size: 12px; }
  .terminal-entry__active-tab { align-self: stretch; display: flex; align-items: center; padding-inline: 18px; background: #292e42; color: #c0caf5; }
  .terminal-entry__new-tab { padding-inline: 12px; }
  .terminal-entry__window-title { margin-inline: auto 16px; overflow: hidden; text-overflow: ellipsis; }
  .terminal-entry__app-name { padding-inline-end: 12px; color: var(--terminal-blue); }
  .terminal-entry__screen { flex: 1; min-block-size: 0; padding: 18px 22px; overflow: auto; scrollbar-width: thin; scrollbar-color: #414868 transparent; }
  .terminal-entry__fetch { display: flex; gap: 4ch; align-items: center; margin-block: 1.5em; }
  .terminal-entry__arch { flex: 0 0 auto; margin: 0; padding: 0; border: 0; border-radius: 0; background: none; color: var(--terminal-cyan); font: inherit; line-height: 1.5; white-space: pre; overflow: visible; }
  .terminal-entry__arch--small { display: none; }
  .terminal-entry__system { min-inline-size: 0; }
  .terminal-entry__user, .terminal-entry__key { color: var(--terminal-blue); }
  .terminal-entry__directory { color: var(--terminal-cyan); }
  .terminal-entry__branch { color: #bb9af7; }
  .terminal-entry__muted { color: var(--terminal-muted); }
  .terminal-entry__prompt, .terminal-entry__executable { color: var(--terminal-green); }
  .terminal-entry__colors { display: flex; margin-block-start: 1em; block-size: 1em; }
  .terminal-entry__colors > span { inline-size: 2ch; white-space: pre; }
  .terminal-entry__colors--bright { margin-block-start: 0; filter: brightness(1.18); }
  .terminal-entry__history, .terminal-entry__failure { margin-block-end: 1em; }
  .terminal-entry__path { overflow-wrap: anywhere; }
  .terminal-entry__command { min-block-size: 1.5em; white-space: pre-wrap; overflow-wrap: anywhere; }
  .terminal-entry__cursor { display: inline-block; inline-size: 1ch; block-size: 1.15em; background: #c0caf5; vertical-align: -0.18em; animation: terminal-cursor 1.2s step-end infinite; }
  .terminal-entry:is([data-stage='typing'], [data-stage='typo'], [data-stage='correcting']) .terminal-entry__input .terminal-entry__cursor { animation: none; }
  .terminal-entry:is([data-stage='confirming'], [data-stage='confirmed'], [data-stage='loading'], [data-stage='ready'], [data-stage='done']) .terminal-entry__input .terminal-entry__cursor { visibility: hidden; }
  .terminal-entry__confirmation { white-space: pre-wrap; overflow-wrap: anywhere; }
  .terminal-entry:not([data-stage='confirming']) .terminal-entry__confirmation .terminal-entry__cursor { visibility: hidden; }
  .terminal-entry__error { color: #f7768e; }
  .terminal-entry__step { display: none; overflow-wrap: anywhere; }
  .terminal-entry__step[data-state] { display: block; }
  .terminal-entry__step-mark::before { content: '[ .. ]'; color: #e0af68; }
  .terminal-entry__step[data-state='active'] .terminal-entry__step-mark::before { animation: terminal-spinner 800ms step-end infinite; }
  .terminal-entry__step[data-state='complete'] .terminal-entry__step-mark::before { content: '[ OK ]'; color: var(--terminal-green); }
  .terminal-entry__result { color: var(--terminal-green); overflow-wrap: anywhere; }
  .terminal-entry__next-prompt { display: none; margin-block-start: 1em; }
  .terminal-entry:is([data-stage='ready'], [data-stage='done']) .terminal-entry__next-prompt { display: block; }
  .terminal-entry__boot-prompt { display: none; }
  .terminal-entry[data-stage='booting'] .terminal-entry__boot-prompt { display: block; }
  .terminal-entry[data-stage='booting'] .terminal-entry__fetch-command,
  .terminal-entry[data-stage='booting'] .terminal-entry__fetch,
  .terminal-entry[data-stage='booting'] .terminal-entry__history,
  .terminal-entry[data-stage='booting'] .terminal-entry__input,
  .terminal-entry[data-stage='inspecting'] .terminal-entry__history,
  .terminal-entry[data-stage='inspecting'] .terminal-entry__input { display: none; }
  .terminal-entry__accessible-status { position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @keyframes terminal-map { from { opacity: 0; } to { opacity: 1; } }
  @keyframes terminal-cursor { 50% { opacity: 0; } }
  @keyframes terminal-spinner { 0%, 100% { content: '[ / ]'; } 25% { content: '[ - ]'; } 50% { content: '[ \\ ]'; } 75% { content: '[ | ]'; } }
  @media (max-width: 700px) {
    .terminal-entry { font-size: 12px; }
    .terminal-entry__screen { padding: 12px; }
    .terminal-entry__fetch { gap: 2ch; }
    .terminal-entry__arch--full { display: none; }
    .terminal-entry__arch--small { display: block; }
  }
  @media (max-width: 480px) {
    .terminal-entry { padding: 6px; }
    .terminal-entry__tabs { font-size: 10px; block-size: 26px; }
    .terminal-entry__active-tab { padding-inline: 10px; }
    .terminal-entry__window-title { display: none; }
    .terminal-entry__app-name { margin-inline-start: auto; }
    .terminal-entry__fetch { gap: 2ch; margin-block: 1em; }
    .terminal-entry__branch { display: none; }
    .terminal-entry__screen { padding: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .terminal-entry, .terminal-entry::backdrop, .terminal-entry *, .terminal-entry *::before { animation: none !important; transition: none !important; } }
</style>
