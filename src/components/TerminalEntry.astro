<dialog class="terminal-entry" data-terminal-entry aria-labelledby="terminal-title" aria-describedby="terminal-help">
	<div class="terminal-entry__aura" aria-hidden="true"></div>
	<div class="terminal-entry__shell">
		<header class="terminal-entry__chrome" aria-hidden="true">
			<span class="terminal-entry__lights"><i></i><i></i><i></i></span>
			<span>tsukimi41 — workspace</span><span class="terminal-entry__workspace">⌘ 01</span>
		</header>
		<div class="terminal-entry__tabs" aria-hidden="true"><span>01 &nbsp; ~/portfolio</span><span>02 &nbsp; wezterm.lua</span><span>＋</span></div>
		<div class="terminal-entry__body">
			<section class="terminal-entry__session">
				<p class="terminal-entry__eyebrow">PERSONAL WORKSPACE <span>● ONLINE</span></p>
				<h2 id="terminal-title">Hello, world<span>.</span></h2>
				<p class="terminal-entry__intro">小さな好奇心から、次のものづくりへ。</p>
				<div class="terminal-entry__output" aria-hidden="true">
					<p class="terminal-entry__path"><span>tsukimi41</span> <span>~/portfolio</span> <span>git:(main)</span></p>
					<p class="terminal-entry__command"><span>❯</span> <span data-terminal-command></span><span class="terminal-entry__cursor"></span></p>
					<p class="terminal-entry__message" data-terminal-message> </p>
					<p class="terminal-entry__result" data-terminal-result> </p>
				</div>
			</section>
			<aside class="terminal-entry__config" aria-hidden="true">
				<p><span>◐</span> LUNAR / NIGHT</p>
				<pre><span>local</span> wezterm = <span>require</span> <em>'wezterm'</em>

<span>return</span> {'{'}
  color_scheme = <em>'Lunar Night'</em>,
  window_background_opacity = <b>0.96</b>,
  cursor_blink_rate = <b>500</b>,
  default_cursor_style = <em>'SteadyBar'</em>,
{'}'}</pre>
				<div class="terminal-entry__palette"><i></i><i></i><i></i><i></i><i></i></div>
			</aside>
		</div>
		<footer class="terminal-entry__status"><span><span class="terminal-entry__diamond">◆</span> TSUKIMI41 <span class="terminal-entry__status-detail">/ portfolio</span></span><span>UTF-8 &nbsp; <span class="terminal-entry__diamond">●</span> zsh</span></footer>
	</div>
	<div class="terminal-entry__below">
		<p id="terminal-help">自動でサイトを開きます。<kbd>Esc</kbd> / <kbd>Tab</kbd> でスキップ</p>
		<button type="button" data-terminal-skip autofocus>サイトへ進む <span aria-hidden="true">↗</span></button>
	</div>
</dialog>

<script>
	import '../scripts/terminal-entry';
</script>

<style>
