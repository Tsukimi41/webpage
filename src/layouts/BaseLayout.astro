---
import ThemeInitializer from '../components/ThemeInitializer.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import SkipLink from '../components/SkipLink.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	lang?: string;
}

const { title, description, lang = 'ja' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<ThemeInitializer />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<SkipLink />
		<main>
			<ThemeSwitcher />
			<div id="main-content" class="page-content" tabindex="-1">
				<slot />
			</div>
		</main>
	</body>
</html>

<style>
	.page-content:focus {
		outline: none;
	}
</style>
