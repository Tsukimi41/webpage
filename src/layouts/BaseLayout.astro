---
import ThemeInitializer from '../components/ThemeInitializer.astro';
import SkipLink from '../components/SkipLink.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
	createCanonicalUrl,
	defineSiteUrl,
	serializeJsonLd,
	siteMetadata,
} from '../config/site';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	lang?: string;
	pageType?: 'website' | 'article';
	publishedAt?: string;
	updatedAt?: string;
	indexing?: 'auto' | 'disabled';
}

const {
	title,
	description,
	lang = siteMetadata.language,
	pageType = 'website',
	publishedAt,
	updatedAt,
	indexing = 'auto',
} = Astro.props;
const siteUrl = defineSiteUrl(import.meta.env.PUBLIC_SITE_URL);
const siteHref = Astro.site?.href ?? siteUrl.href;
const canonicalUrl = createCanonicalUrl(siteHref, Astro.url.pathname);
const isIndexable = indexing === 'auto' && siteUrl.isPublic;
const robotsContent = isIndexable ? 'index, follow' : 'noindex, nofollow';
const rssUrl = new URL('/rss.xml', siteHref).href;
const structuredData = serializeJsonLd({
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: siteMetadata.name,
	url: siteHref,
	inLanguage: lang,
	author: {
		'@type': 'Person',
		name: siteMetadata.authorName,
		alternateName: siteMetadata.authorHandle,
	},
});
---

<!doctype html>
<html lang={lang}>
	<head>
		<link rel="icon" href={profile.icon.src} />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<ThemeInitializer />
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		{indexing === 'auto' && <link rel="canonical" href={canonicalUrl} />}
		<link rel="alternate" type="application/rss+xml" title={`${siteMetadata.name} RSS`} href={rssUrl} />
		<meta property="og:type" content={pageType} />
		<meta property="og:site_name" content={siteMetadata.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{indexing === 'auto' && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:locale" content={siteMetadata.locale} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{pageType === 'article' && publishedAt && (
			<meta property="article:published_time" content={`${publishedAt}T00:00:00.000Z`} />
		)}
		{pageType === 'article' && updatedAt && (
			<meta property="article:modified_time" content={`${updatedAt}T00:00:00.000Z`} />
		)}
		<script is:inline type="application/ld+json" set:html={structuredData}></script>
		<title>{title}</title>
	</head>
	<body id="site-top">
		<SkipLink />
		<SiteHeader />
		<main>
			<div id="main-content" class="page-content" tabindex="-1">
				<slot />
			</div>
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	.page-content:focus {
		outline: none;
	}
</style>
