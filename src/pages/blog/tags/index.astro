---
import ContentStateNotice from '../../../components/ContentStateNotice.astro';
import { getBlogPostsForTag, getBlogTags } from '../../../content/blog';
import { profileDisplayName } from '../../../data/profile';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const tags = getBlogTags();
const includesMockData = tags.some((tag) => tag.state === 'mock');
const pageTitle = `ブログのタグ | ${profileDisplayName}`;
const pageDescription = `${profileDisplayName}のブログ記事をタグから探せます。`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<div class="tag-index">
		<a class="tag-index__back" href="/blog/">ブログ一覧へ戻る</a>
		<header class="tag-index__header">
			<div>
				<p class="tag-index__eyebrow" aria-hidden="true">BLOG TAGS</p>
				<h1>タグ</h1>
			</div>
			<ContentStateNotice hasMockData={includesMockData} />
		</header>

		{tags.length > 0 ? (
			<ul class="tag-index__list" role="list">
				{tags.map((tag) => {
					const postCount = getBlogPostsForTag(tag.id, { states: [tag.state] }).length;
					return (
						<li data-content-state={tag.state}>
							<a href={`/blog/tags/${tag.id}/`}>
								<span class="tag-index__label">{tag.label}</span>
								<span class="tag-index__count">{postCount}件</span>
								<span class="tag-index__description">{tag.description}</span>
							</a>
						</li>
					);
				})}
			</ul>
		) : (
			<p class="tag-index__empty">表示できるタグはありません。</p>
		)}
	</div>
</BaseLayout>

<style>
	.tag-index {
		padding-block: clamp(var(--space-3), 6vw, var(--space-5));
	}

	.tag-index__back {
		display: inline-flex;
		min-block-size: 2.75rem;
		align-items: center;
		color: var(--color-text-muted);
		font-weight: 700;
		text-underline-offset: 0.25em;
	}

	.tag-index__back:hover {
		color: var(--color-accent);
	}

	.tag-index__back:focus-visible,
	.tag-index__list a:focus-visible {
		outline: 0.1875rem solid var(--color-accent);
		outline-offset: 0.1875rem;
	}

	.tag-index__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-3);
		margin-block: var(--space-4);
		padding-block-end: var(--space-3);
		border-block-end: 1px solid var(--color-border);
	}

	.tag-index__eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.tag-index__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-index__list a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: var(--space-1) var(--space-2);
		min-block-size: 100%;
		padding: var(--space-3);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		text-decoration: none;
	}

	.tag-index__list a:hover {
		border-color: var(--color-accent);
	}

	.tag-index__label {
		font-size: 1.2rem;
		font-weight: 800;
		overflow-wrap: anywhere;
	}

	.tag-index__count {
		color: var(--color-accent);
		font-size: 0.8125rem;
		font-weight: 800;
	}

	.tag-index__description {
		grid-column: 1 / -1;
		color: var(--color-text-muted);
		overflow-wrap: anywhere;
	}

	.tag-index__empty {
		padding: var(--space-4);
		border: 1px dashed var(--color-border);
		text-align: center;
	}

	@media (max-width: 30rem) {
		.tag-index__header {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
