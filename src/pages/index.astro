---
import ProfileIntroduction from '../components/ProfileIntroduction.astro';
import { profile, profileDisplayName } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = `${profileDisplayName} | ポートフォリオ`;
const pageDescription = `${profileDisplayName}のポートフォリオ。${profile.affiliation.university} ${profile.affiliation.faculty}で学んでいます。`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<ProfileIntroduction />
</BaseLayout>
