---
import SocialLinks from '../components/SocialLinks.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Tsukimi41 / 薪のポートフォリオ。電気通信大学 情報理工学域 Ⅱ類で学んでいます。"
		/>
		<title>Tsukimi41 / 薪 | ポートフォリオ</title>
	</head>
	<body>
		<main>
			<section class="introduction" aria-labelledby="introduction-title">
				<h1 id="introduction-title" class="introduction__name">
					<span>Tsukimi41</span>
					<span class="introduction__separator" aria-hidden="true">/</span>
					<span lang="ja">薪</span>
				</h1>
				<p class="introduction__affiliation">
					<span>電気通信大学</span>
					<span>情報理工学域 Ⅱ類</span>
				</p>
				<SocialLinks />
			</section>
		</main>
	</body>
</html>

<style>
	.introduction {
		position: relative;
		overflow: hidden;
		padding: clamp(var(--space-3), 6vw, var(--space-5));
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		background: var(--color-surface);
		box-shadow: 0 1.5rem 4rem var(--color-shadow);
	}

	.introduction::before {
		position: absolute;
		inset-block-start: 0;
		inset-inline: 0;
		block-size: 0.1875rem;
		background: linear-gradient(90deg, var(--color-accent), var(--color-accent-strong));
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		animation: accent-line-enter 600ms 180ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	.introduction__name {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--space-2);
		word-break: keep-all;
		animation: content-enter 420ms 100ms ease-out both;
	}

	.introduction__separator {
		color: var(--color-border);
		font-weight: 400;
	}

	.introduction__affiliation {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin-block-start: var(--space-3);
		font-weight: 600;
		animation: content-enter 420ms 180ms ease-out both;
	}

	@keyframes accent-line-enter {
		to {
			transform: scaleX(1);
		}
	}

	@keyframes content-enter {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.introduction::before,
		.introduction__name,
		.introduction__affiliation {
			animation: none;
		}

		.introduction::before {
			transform: scaleX(1);
		}
	}
</style>
