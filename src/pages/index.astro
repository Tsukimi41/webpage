---
import SocialLinks from '../components/SocialLinks.astro';
import ThemeInitializer from '../components/ThemeInitializer.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<ThemeInitializer />
		<meta
			name="description"
			content="Tsukimi41 / 薪のポートフォリオ。電気通信大学 情報理工学域 Ⅱ類で学んでいます。"
		/>
		<title>Tsukimi41 / 薪 | ポートフォリオ</title>
	</head>
	<body>
		<main>
			<ThemeSwitcher />
			<section class="introduction" aria-labelledby="introduction-title">
				<h1 id="introduction-title" class="introduction__name">
					<span>Tsukimi41</span>
					<span class="introduction__separator" aria-hidden="true">/</span>
					<span lang="ja">薪</span>
				</h1>
				<p class="introduction__affiliation">
					<span>電気通信大学</span>
					<span>情報理工学域 Ⅱ類</span>
				</p>
				<SocialLinks />
			</section>
		</main>
	</body>
</html>

<style>
	.introduction {
		position: relative;
		display: grid;
		align-content: center;
		overflow: hidden;
		min-block-size: min(42rem, 72svh);
		padding: clamp(var(--space-3), 7vw, 6rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		background:
			linear-gradient(135deg, var(--color-surface-raised) 0 1px, transparent 1px) 100% 0 / 8rem 8rem no-repeat,
			color-mix(in srgb, var(--color-surface) 92%, transparent);
		box-shadow: 0 1.5rem 4rem var(--color-shadow);
	}

	.introduction::before {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
		inline-size: min(42%, 24rem);
		block-size: 0.1875rem;
		background: linear-gradient(90deg, var(--color-accent), var(--color-accent-strong));
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		animation: accent-line-enter 600ms 180ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	.introduction::after {
		position: absolute;
		inset-block-end: clamp(var(--space-2), 3vw, var(--space-4));
		inset-inline-end: clamp(var(--space-2), 3vw, var(--space-4));
		inline-size: clamp(2rem, 6vw, 4rem);
		aspect-ratio: 1;
		border-inline-end: 1px solid var(--color-accent);
		border-block-end: 1px solid var(--color-accent);
		content: '';
		opacity: 0.65;
	}

	.introduction__name {
		display: flex;
		flex-wrap: nowrap;
		align-items: baseline;
		gap: 0 clamp(var(--space-1), 2vw, var(--space-3));
		inline-size: max-content;
		max-inline-size: 100%;
		white-space: nowrap;
		word-break: keep-all;
		animation: content-enter 420ms 100ms ease-out both;
	}

	.introduction__separator {
		color: var(--color-accent-strong);
		font-weight: 300;
		transform: translateY(-0.06em);
	}

	.introduction__affiliation {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin-block-start: var(--space-3);
		padding-inline-start: var(--space-2);
		border-inline-start: 1px solid var(--color-accent);
		font-weight: 600;
		animation: content-enter 420ms 180ms ease-out both;
	}

	@keyframes accent-line-enter {
		to {
			transform: scaleX(1);
		}
	}

	@keyframes content-enter {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.introduction::before,
		.introduction__name,
		.introduction__affiliation {
			animation: none;
		}

		.introduction::before {
			transform: scaleX(1);
		}
	}

	@media (min-width: 48rem) {
		.introduction__affiliation {
			inline-size: max-content;
			margin-inline-start: min(44%, 22rem);
		}
	}

	@media (max-width: 30rem) {
		.introduction {
			min-block-size: 70svh;
		}

		.introduction__name {
			font-size: clamp(1.65rem, 8vw, 2rem);
		}
	}
</style>
