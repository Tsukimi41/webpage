---
import ProfileIntroduction from '../components/ProfileIntroduction.astro';
import ArticleShowcase from '../components/ArticleShowcase.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import SkillShowcase from '../components/SkillShowcase.astro';
import { getArticleFeed } from '../content/articles';
import { getProjects } from '../content/projects';
import { getSkills } from '../content/skills';
import { profile, profileDisplayName } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalEntry from '../components/TerminalEntry.astro';

const pageTitle = `${profileDisplayName} | ポートフォリオ`;
const pageDescription = `${profileDisplayName}のポートフォリオ。${profile.affiliation.university} ${profile.affiliation.faculty}で学んでいます。`;
const projects = getProjects();
const skills = getSkills();
const articleFeed = getArticleFeed();
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<TerminalEntry />
	<ProfileIntroduction />
	<ArticleShowcase items={articleFeed} />
	<SkillShowcase skills={skills} />
	<ProjectShowcase projects={projects} />
</BaseLayout>
