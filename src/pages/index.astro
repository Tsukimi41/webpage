---
import ProfileIntroduction from '../components/ProfileIntroduction.astro';
import ThemeInitializer from '../components/ThemeInitializer.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { profile, profileDisplayName } from '../data/profile';
import '../styles/global.css';

const pageDescription = `${profileDisplayName}のポートフォリオ。${profile.affiliation.university} ${profile.affiliation.faculty}で学んでいます。`;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<ThemeInitializer />
		<meta
			name="description"
			content={pageDescription}
		/>
		<title>{profileDisplayName} | ポートフォリオ</title>
	</head>
	<body>
		<main>
			<ThemeSwitcher />
			<ProfileIntroduction />
		</main>
	</body>
</html>
