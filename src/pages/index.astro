---
import ProfileIntroduction from '../components/ProfileIntroduction.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import SkillShowcase from '../components/SkillShowcase.astro';
import TimelineShowcase from '../components/TimelineShowcase.astro';
import { getFeaturedProjects, getProjects } from '../content/projects';
import { getSkills } from '../content/skills';
import { getTimelineEntries } from '../content/timeline';
import { profile, profileDisplayName } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = `${profileDisplayName} | ポートフォリオ`;
const pageDescription = `${profileDisplayName}のポートフォリオ。${profile.affiliation.university} ${profile.affiliation.faculty}で学んでいます。`;
const featuredProjects = getFeaturedProjects({ limit: 3 });
const skills = getSkills();
const projects = getProjects();
const recentTimelineEntries = getTimelineEntries({ limit: 3 });
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<ProfileIntroduction />
	<SkillShowcase skills={skills} projects={projects} />
	<ProjectShowcase projects={featuredProjects} />
	<TimelineShowcase entries={recentTimelineEntries} projects={projects} />
</BaseLayout>
